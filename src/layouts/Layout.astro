---
import '../styles/fonts.css';
import IntroLoader from '../components/IntroLoader.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /**
   * Giriş animasyonu. Yalnızca ana sayfada açılır; bir haber bağlantısıyla
   * doğrudan iç sayfaya gelen kullanıcıyı animasyonla karşılamak gereksiz.
   */
  intro?: boolean;
}

const {
  title = "Kocaeli Kadın Futbol Kulübü",
  description = "Kocaeli Kadın Futbol Kulübü resmi web sitesi. A Takım, Pilot Takım, akademi, maç sonuçları ve haberler. Kadın futbolunun Kocaeli'deki gücü.",
  image = "/logo.jpeg",
  noindex = false,
  intro = false,
} = Astro.props;

const siteUrl = Astro.site?.href ?? "https://kocaelikadinfa.com/";
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const ogImage = new URL(image, siteUrl);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SportsOrganization",
  name: "Kocaeli Kadın Futbol Kulübü",
  alternateName: "Kocaeli Kadın FA",
  url: siteUrl,
  logo: new URL("/logo.jpeg", siteUrl).href,
  image: ogImage.href,
  description,
  sport: "Kadın Futbolu",
  email: "kocaelikadinfa@gmail.com",
  telephone: "+905326944509",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Kozluk",
    addressLocality: "İzmit",
    addressRegion: "Kocaeli",
    postalCode: "41200",
    addressCountry: "TR",
  },
  sameAs: [
    "https://www.instagram.com/kocaelikadinfa",
    "https://www.youtube.com/@kocaelikadinfa",
    "https://www.tiktok.com/@kocaelikadinfutbol",
    "https://x.com/kocaelikadnfa",
  ],
};
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/logo.jpeg" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta name="theme-color" content="#0d4d1e" />
    <meta name="author" content="Kocaeli Kadın Futbol Kulübü" />
    <meta name="geo.region" content="TR-41" />
    <meta name="geo.placename" content="Kocaeli" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kocaeli Kadın Futbol Kulübü" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="tr_TR" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Font indirmesi, stil dosyası işlenmeyi beklemeden hemen başlasın.
         crossorigin, aynı sunucudan gelse bile font preload'ları için şart. -->
    <link rel="preload" href="/fonts/montserrat-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/montserrat-latin-ext.woff2" as="font" type="font/woff2" crossorigin />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <!-- Klavyeyle gezenler her sayfada logo + 6 menü linki + butonu geçmek
         için 8 kez Tab'a basmak zorundaydı. Bu bağlantı normalde görünmez,
         Tab'a basınca beliriyor ve tek seferde içeriğe atlıyor. -->
    <a href="#icerik" class="skip-link">İçeriğe geç</a>

    {intro
      ? <IntroLoader />
      : <script is:inline>
          /* İç sayfadan giren kullanıcı, aynı oturumda ana sayfaya geçtiğinde
             animasyonla karşılaşmasın. */
          try { sessionStorage.setItem('kkfa-intro-seen', '1'); } catch (e) {}
        </script>}
    <slot />
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    /* ══ TASARIM SİSTEMİ ══════════════════════════════════════════════
       Ölçüm (2026-10-29, halka açık .astro kapsamı, IntroLoader ve admin
       hariç): 29 ayrı hex 62 yerde, 20 degrade, --green-bright 82 çağrı,
       296 ham padding/margin/gap değeri. Karşılaştırma için Venezia FC ana
       sayfası 1274 öğeyi 9 boyut, 3 ağırlık ve TEK harf aralığıyla
       yönetiyor. "Amatör" hissi tek tek efektlerden değil, her bölümün
       kendi kararını vermiş olmasından geliyor.

       Bu blok hedef sistemi tanımlar. Bileşenler henüz çoğunlukla kendi
       ham değerlerini kullanıyor; göç dosya dosya yapılacak (bkz.
       SADELESTIRME-PLANI.md, Faz D). Token'ların burada olması göçün
       önkoşulu — tek tek dosyalar bunlara bağlanabilsin diye.           */

    /* ── Tipografi ── */
    --fs-eyebrow: .6875rem;                              /* 11px */
    --fs-sm:      .8125rem;                              /* 13px */
    --fs-base:    1rem;                                  /* 16px */
    --fs-md:      1.125rem;                              /* 18px */
    --fs-lg:      1.5rem;                                /* 24px */
    --fs-xl:      clamp(1.75rem, 2.5vw + 1rem, 2.5rem);  /* 28→40px, h2 */
    --fs-display: clamp(2.25rem, 4vw + 1rem, 3.5rem);    /* 36→56px, h1 */

    --fw-normal: 400;
    --fw-medium: 500;
    --fw-bold:   700;

    --ls-display: -.02em;
    --ls-tight:   -.01em;
    --ls-eyebrow: .14em;

    --lh-tight: 1.1;
    --lh-snug:  1.3;
    --lh-body:  1.65;

    /* ── Renk ──
       Kontrast oranları siyah zemine göre ölçüldü; hepsi WCAG AA üstü. */
    --text:       #ffffff;   /* başlık            21:1    */
    --text-body:  #d6d6d6;   /* gövde paragrafı   14,45:1 */
    --text-muted: #9a9a9a;   /* meta, footer menü  7,46:1 */
    --text-dim:   #8a8a8a;   /* telif              6,08:1 — en soluk sınır */

    --black:     #000000;
    --surface:   #0b0e0b;
    --surface-2: #141814;

    --green:        #0d4d1e;   /* yalnız DOLGU  */
    --green-mid:    #116025;   /* yalnız hover  */
    --green-bright: #2cb84a;   /* yalnız KÜÇÜK METİN */

    --border:        rgba(255,255,255,.08);
    --border-strong: rgba(255,255,255,.14);
    --surface-hover: rgba(255,255,255,.04);
    --green-wash:    rgba(44,184,74,.08);
    --scrim:         rgba(0,0,0,.80);

    /* ── Rol renkleri — her biri TEK işli. Kontrast: siyah / --surface ── */
    --kemik:   #f2efe9;   /* kırık beyaz: TÜM h1 ve h2.         18,30:1 */
    --amber:   #d4a052;   /* nötr dikkat: ne iyi ne kötü.  8,95:1 / 8,27:1 */
    --kirmizi: #e05555;   /* hata ve kayıp.                5,60:1 / 5,18:1 */
    --link:    #4da6ff;   /* YALNIZ haber gövdesi içi bağlantı. 8,21:1 / 7,59:1 */

    /* Alt navigasyon çubuğu BİLİNÇLİ olarak site paletinin dışında: renkleri
       NERVA referans VİDEOSUNUN karelerinden örneklendi (poster görseli
       değil; video tuvale çizilip baskın tonlar sayıldı), böylece çubuk
       referanstaki gibi duruyor. Kontrastlar --alt-nav-zemin üstünde ölçüldü.
       Tek sapma pasif etiket: referanstaki #a8aaa9 yalnız 1,83:1 veriyor ve
       AA'yı geçmiyor; gerçek sitede okunmaz kalırdı, bu yüzden AA geçen en
       açık tona çekildi. */
    --alt-nav-zemin: #e4e6e5;              /* opak yedek (cam desteklenmezse) */
    --alt-nav-cam:   rgba(228,230,229,.88); /* buzlu cam yüzey                */
    --alt-nav-vurgu: #092117;              /* kapsül ve CTA dairesi           */
    --alt-nav-aktif: #000603;              /* aktif etiket                    */
    --alt-nav-pasif: #4a4e4b;              /* pasif ikon ve etiket            */

    /* Kontrastlar EN KÖTÜ duruma göre ölçüldü: cam %88 saydam olduğu için
       arkada saf siyah varken etkin zemin #c7c9c8'e düşüyor. O zeminde
       kapsül 9,85:1, aktif etiket 12,28:1, pasif etiket 5,08:1. Pasif ton
       bu yüzden #5f6360'tan koyultuldu; eski değer camda 3,67:1 kalıyordu.
       Arkada fotoğraf ya da açık içerik varsa zemin açılır, oranlar artar. */

    --amber-wash:   rgba(212,160,82,.14);   /* yalnız beraberlik rozeti zemini */
    --kirmizi-wash: rgba(224,85,85,.14);    /* yalnız mağlubiyet rozeti zemini */

    /* ── Boşluk (4px ızgara) ── */
    --sp-1: .5rem;     /*  8px */
    --sp-2: .75rem;    /* 12px */
    --sp-3: 1.25rem;   /* 20px */
    --sp-4: 2rem;      /* 32px */
    --sp-5: 3rem;      /* 48px */
    --sp-6: 5rem;      /* 80px */

    --gutter:       clamp(1.25rem, 5vw, 4rem);
    --measure:      1120px;   /* ızgara / bölüm genişliği */
    --measure-text: 620px;    /* paragraf ~66 karakter/satır */

    /* ── Köşe ── */
    --r-sm:   6px;
    --r-md:   12px;
    --r-pill: 999px;

    --nav-h: 70px;

    /* ── Eski adlar: ALIAS, silinmedi ──────────────────────────────────
       --dark, --card-bg ve --radius 12 dosyada ~51 yerde çağrılıyor
       (Layout'un kendi scrollbar kuralı dahil). Silinirlerse zeminler
       saydamlaşır ve panel köşeleri 0'a düşer. Alias ile sıfır regresyonla
       geçiliyor; çağrı yerleri Faz D'de tek tek temizlenecek.           */
    --dark:       var(--surface);
    --card-bg:    var(--surface);
    --radius:     var(--r-md);

    /* ── Görsel boyut sistemi ──────────────────────────────────────────
       Fotoğraflar kendi en-boy oranını korur; yalnızca bu sınırların
       dışına taşanlar kırpılır. Böylece aşırı uzun dikey fotoğraflar
       sayfayı ele geçirmez, aşırı geniş olanlar da şeride dönmez.     */
    --media-min-h:     170px;   /* çok geniş fotoğraflar için taban   */
    --media-max-h:     520px;   /* çok uzun fotoğraflar için tavan    */
    --media-max-h-sm:  380px;   /* tek kolona düşen dar ekranlarda    */
    --card-media-max-h: 440px;  /* sabit oranlı haber kartı görselleri */
  }

  /* Tüm görseller kapsayıcısını taşmasın */
  img { max-width: 100%; }

  html { scroll-behavior: smooth; }

  body {
    font-family: var(--font-montserrat), sans-serif;
    background: var(--black);
    color: var(--text);
    line-height: 1.6;
  }

  /* ══ Tipografik roller (§6.1) ═══════════════════════════════════════
     Tüm halka açık sayfalarda aynı. Bileşenler bu rolleri yeniden
     tanımlamaz; yalnız ana sayfa h1'i (--fs-display) ve PageHero h1'i
     (sayfa başına clamp) kendi boyutunu verir.
     DİKKAT: scoped bir kural (0,2,0+) bu global element kurallarını
     (0,0,1) ezer; bir başlık rolün dışına çıkıyorsa nedeni bileşendeki
     yerel kuraldır, sıra değil (§8.0/A). */
  h1, h2 { color: var(--kemik); text-wrap: balance; }
  h2 {
    font-size: var(--fs-xl);
    font-weight: var(--fw-bold);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-tight);
    max-width: 20ch;
  }
  h3 {
    font-size: var(--fs-md);
    font-weight: var(--fw-medium);
    line-height: var(--lh-snug);
    color: var(--text);
  }
  p {
    font-size: var(--fs-base);
    line-height: var(--lh-body);
    color: var(--text-body);
    max-width: var(--measure-text);
    text-wrap: pretty;
  }

  ::-webkit-scrollbar { width: 6px; }
  ::-webkit-scrollbar-track { background: var(--dark); }
  ::-webkit-scrollbar-thumb { background: var(--green); border-radius: 3px; }

  .btn-primary {
    display: inline-block;
    background: var(--green);
    color: var(--text);
    padding: var(--sp-2) var(--sp-4);
    border-radius: var(--r-pill);
    font-weight: var(--fw-bold);
    font-size: var(--fs-base);
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: background .25s;
  }
  /* Hover yalnız zemin tonu: glow ve zıplama yok (dekoratif hareket değil, durum bildirimi) */
  .btn-primary:hover { background: var(--green-mid); }

  /* ══ Bölüm kabı (§2.3) ═════════════════════════════════════════════
     .band > .band-inner — sırası sabit: (eyebrow) · h2 · (tek giriş
     paragrafı) · içerik · (tek ikincil bağlantı). Sayfalar bu kalıbın
     dışında düzen CSS'i yazmaz; bölüm dolgusu yalnız burada tanımlıdır.

     Sınıf adı bilerek `.section` DEĞİL: aramiza-katil.astro'da eskiden
     scoped bir `.section` vardı ve Astro onu [data-astro-cid-…] ile 0,2,0
     özgüllüğe çıkarıyor; global bir `.section` (0,1,0) sıra ne olursa
     olsun kaybederdi.                                                   */
  .band {
    padding-block: var(--sp-6);
    padding-inline: var(--gutter);
  }
  .band-inner {
    max-width: var(--measure);
    margin-inline: auto;
  }
  @media (max-width: 768px) {
    .band { padding-block: var(--sp-5); }
  }
  /* Bölüm içi dikey ritim: başlık → içerik --sp-4, eyebrow → h2 --sp-2
     (eyebrow'un kendi alt boşluğu), h1/h2 → giriş paragrafı --sp-3. */
  .band-inner > * + * { margin-top: var(--sp-4); }
  .band-inner > .eyebrow + h1,
  .band-inner > .eyebrow + h2 { margin-top: 0; }
  .band-inner > h1 + p,
  .band-inner > h2 + p { margin-top: var(--sp-3); }

  /* ══ Üst etiket ════════════════════════════════════════════════════
     Eski .section-tag ile aynı kural iki kez tanımlanıyordu; tek sınıf.
     Tracking ve uppercase EKLENEN tek yer burası; gövdeye harf aralığı
     yazılmaz, başka hiçbir ölçekte uppercase kullanılmaz.               */
  .eyebrow {
    display: inline-block;
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-medium);
    line-height: 1;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--green-bright);
    margin-bottom: var(--sp-2);
  }

  /* ══ Kart anatomisi (§2.3) — 10 sayfada aynı dört parça ═══════════
     1 görsel .card-media (4/3, kırpma odağı üstte: yüzler kadrajın üst
       yarısında) · 2 başlık .card-title (h3 rolü, ≤3 satır) · 3 meta
       .card-meta (tarih/altyazı) · 4 dolgu, zemin, 1px kenarlık, köşe.
     Kartın tamamı tek <a> ya da tek <button>; eyebrow, kategori etiketi
     ve "Devamını oku" YOK. Hover yalnız kenarlık rengi.                 */
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    padding: var(--sp-3);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    color: inherit;
    font: inherit;
    text-align: left;
    text-decoration: none;
    transition: border-color .15s ease;
  }
  button.card { width: 100%; cursor: pointer; }
  .card:hover { border-color: var(--border-strong); }
  .card:focus-visible { outline: 2px solid var(--green-bright); outline-offset: 3px; }
  .card-media {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--r-sm);
    background: var(--black);
  }
  .card-media img,
  .card-media iframe {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
    border: 0;
  }
  .card-title {
    font-size: var(--fs-md);
    font-weight: var(--fw-medium);
    line-height: var(--lh-snug);
    color: var(--text);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-meta {
    display: block;
    /* Altyazı şeridi kart yüksekliğini belirlemez ve boşken kaybolmaz:
       galeri kartlarının çoğunda caption boş (actions.ts yalnız ilk satıra
       yazar); şerit yüksekliğini korur, içine hiçbir şey basılmaz (§7.3). */
    min-height: 2.5rem;
    font-size: var(--fs-sm);
    line-height: var(--lh-snug);
    color: var(--text-muted);
  }
  /* Fotoğrafı olmayan kayıt (§7.6): stok görsel değil, boş çerçeve ve
     ortada 48px'lik tek yatay çizgi. İkon, metin, arma yok.            */
  .foto-yok {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    background: var(--surface-2);
  }
  .foto-yok::after {
    content: '';
    position: absolute;
    top: 50%; left: 50%;
    width: 48px; height: 1px;
    transform: translate(-50%, -50%);
    background: var(--text-dim);
  }

  /* ══ Hareket azaltma ═══════════════════════════════════════════════
     Bu koruma eskiden yalnızca tek tek bileşenlerin içindeydi (IntroLoader,
     NumberTicker, Navbar, RainBackground). Faz B'de NumberTicker ve
     RainBackground silindi, Navbar'ın shimmer'ı kalktı — korumaları da
     onlarla birlikte giderdi. Bu global blok, hangi bileşen silinirse
     silinsin sözün ayakta kalmasını sağlıyor.                            */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: .01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: .01ms !important;
      scroll-behavior: auto !important;
    }
  }

  /* ── İçeriğe geç ──────────────────────────────────────────────────────
     Ekranda yer kaplamasın diye görüntü alanının dışında durur; yalnızca
     odaklanınca (yani Tab'a basınca) sol üstte belirir. */
  .skip-link {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 2000;
    transform: translateY(-120%);
    background: var(--green-bright);
    color: var(--black);   /* bilinçli yüksek kontrast istisnası: yeşil dolgu üstünde siyah */
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    
    text-decoration: none;
    padding: var(--sp-2) var(--sp-3);
    border-radius: 0 0 var(--r-md) 0;
    box-shadow: 0 6px 20px rgba(0,0,0,.5);
    transition: transform .18s ease;
  }
  .skip-link:focus { transform: translateY(0); }

  /* Giriş animasyonu oynarken kaplamanın arkasında görünmez bir hedef
     olmasın; animasyonun kendi "Geç" butonu zaten ilk sırada. */
  html.kkfk-playing .skip-link { display: none; }

  /* Hedefe odak programatik olarak taşınıyor; sayfa boyu bir çerçeve
     çizmesin — kullanıcı zaten oraya gitmeyi kendisi seçti. */
  #icerik:focus { outline: none; }
</style>
