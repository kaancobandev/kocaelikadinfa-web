---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import { supabase, type Match } from '../lib/supabase';
import { img } from '../lib/img';
import { sonuc, ozet } from '../lib/match';

const { data } = await supabase
  .from('matches')
  .select('*')
  .order('id', { ascending: false });

const matches: Match[] = data ?? [];

// Maçları kategori (badge) başlığına göre dinamik grupla
const groupMap = new Map<string, Match[]>();
for (const m of matches) {
  const key = m.badge || 'Diğer';
  if (!groupMap.has(key)) groupMap.set(key, []);
  groupMap.get(key)!.push(m);
}
const matchGroups: [string, Match[]][] = [...groupMap.entries()];

// Kulüp tespiti src/lib/match.ts'te — eskiden burada `includes('kkfk')`
// vardı ve veritabanındaki ad "Kocaeli Kadın Futbol Kulübü" olduğu için
// hiç eşleşmiyordu; her ev maçı deplasman sayılıp sonuç ters basılıyordu.
const result = sonuc;

const resultLabel = { win: 'G', draw: 'B', loss: 'M', null: '–' } as const;

function initials(name: string) {
  return name.split(' ').map(w => w[0]).slice(0, 2).join('').toUpperCase();
}

const TR_MONTHS = ['Ocak','Şubat','Mart','Nisan','Mayıs','Haziran','Temmuz','Ağustos','Eylül','Ekim','Kasım','Aralık'];
function formatDate(d: string) {
  const m = d.match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if (!m) return d;
  return `${parseInt(m[3])} ${TR_MONTHS[parseInt(m[2]) - 1]} ${m[1]}`;
}

// Özet istatistik — hesap src/lib/match.ts'te (aynı kulüp tespitini kullanır).
// Eskiden `ozet` fonksiyonun kendisine atanıyor, hiç çağrılmıyordu.
// ozet() yalnız { w, d, l, gf, ga } döndürür; oynanan sayısı matches.length.
const stats = ozet(matches);
---

<Layout
  title="Maç Geçmişi & Sonuçlar — Kocaeli Kadın Futbol Kulübü"
  description="Kocaeli Kadın Futbol Kulübü U13, U15 ve A Takım maç sonuçları, fikstür ve istatistikleri. Tüm maçların skorlarını buradan görün."
>
  <Navbar />

  <main id="icerik" tabindex="-1">

    <PageHero
      tag="Sezon 2025–26"
      title="Maç"
      accent="Geçmişi"
      description="Tüm maçlarımızın sonuçları, skorlar ve karşılaştığımız takımlar."
    >
      {/* Sezon künyesi: sayfanın birincil öğesi (§4.3); veri yoksa basılmaz */}
      {matches.length > 0 && (
        <div class="summary-bar" aria-label="Sezon künyesi">
          <div class="summary-item">
            <span class="s-num">{matches.length}</span>
            <span class="s-lbl">Maç</span>
          </div>
          <div class="summary-item">
            <span class="s-num win-color">{stats.w}</span>
            <span class="s-lbl">Galibiyet</span>
          </div>
          <div class="summary-item">
            <span class="s-num draw-color">{stats.d}</span>
            <span class="s-lbl">Beraberlik</span>
          </div>
          <div class="summary-item">
            <span class="s-num loss-color">{stats.l}</span>
            <span class="s-lbl">Mağlubiyet</span>
          </div>
        </div>
      )}
    </PageHero>

    <!-- Kategori başlığına göre dinamik bölümler; kategori adı yalnız h2'de -->
    {matchGroups.map(([title, list]) => (
      <section class="band group-section">
        <div class="band-inner">
          <h2>{title} Maçları</h2>

          <div class="matches-list">
            {list.map(m => {
              const r = result(m);
              return (
                <div class="match-card">
                  <div class="match-meta-left">
                    <span class="match-date">{formatDate(m.match_date)}</span>
                  </div>

                  <div class="match-teams">
                    <div class="team-side home">
                      <div class="team-logo-wrap">
                        {m.home_logo
                          ? <img src={img(m.home_logo, 120)} alt={m.home_name} class="team-logo" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
                          : null
                        }
                        <span class="team-logo-fallback" style={m.home_logo ? 'display:none' : 'display:flex'}>
                          {initials(m.home_name)}
                        </span>
                      </div>
                      <span class="team-name">{m.home_name}</span>
                    </div>

                    <div class="score-center">
                      <span class="score-big">{m.score_home}</span>
                      <span class="score-sep">–</span>
                      <span class="score-big">{m.score_away}</span>
                    </div>

                    <div class="team-side away">
                      <div class="team-logo-wrap">
                        {m.away_logo
                          ? <img src={img(m.away_logo, 120)} alt={m.away_name} class="team-logo" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
                          : null
                        }
                        <span class="team-logo-fallback" style={m.away_logo ? 'display:none' : 'display:flex'}>
                          {initials(m.away_name)}
                        </span>
                      </div>
                      <span class="team-name">{m.away_name}</span>
                    </div>
                  </div>

                  <div class="match-result">
                    <span class={`result-badge ${r ?? ''}`}>
                      {resultLabel[r ?? 'null']}
                    </span>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </section>
    ))}

  </main>

  <Footer />
</Layout>

<style>
  /* ── Grup bölümü: dönüşümlü zemin yok, yalnız ince çizgi ── */
  .group-section {
    background: var(--black);
    border-top: 1px solid var(--border);
  }

  /* ── Sezon künyesi: büyük rakamlar, tabular-nums ── */
  .summary-bar { display: flex; gap: var(--sp-4); flex-wrap: wrap; }
  .summary-item { display: flex; flex-direction: column; align-items: flex-start; gap: var(--sp-1); }
  .s-num { font-size: var(--fs-lg); font-weight: var(--fw-bold); color: var(--text); line-height: var(--lh-tight); font-variant-numeric: tabular-nums; }
  .s-lbl { font-size: var(--fs-eyebrow); font-weight: var(--fw-medium); line-height: 1; letter-spacing: var(--ls-eyebrow); text-transform: uppercase; color: var(--text-muted); }
  /* .s-num'dan sonra tanımlı, aynı özgüllükte: !important gerekmez.
     Galibiyet sayısı yeşil değil — --green-bright --fs-lg ölçeğinde kullanılmaz. */
  .win-color  { color: var(--text); }
  .draw-color { color: var(--amber); }
  .loss-color { color: var(--kirmizi); }

  /* ── Maç kartları ── */
  .matches-list { display: flex; flex-direction: column; gap: var(--sp-2); }

  .match-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    padding: var(--sp-2) var(--sp-3);
    display: grid;
    grid-template-columns: 140px 1fr 56px;
    align-items: center;
    gap: var(--sp-2);
    transition: border-color .15s ease;
  }
  .match-card:hover { border-color: var(--border-strong); }

  .match-meta-left { display: flex; flex-direction: column; }
  .match-date { font-size: var(--fs-sm); line-height: var(--lh-snug); color: var(--text-muted); font-variant-numeric: tabular-nums; }

  /* Takımlar + skor */
  .match-teams {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-3);
  }

  .team-side {
    display: flex;
    align-items: center;
    gap: var(--sp-1);
    flex: 1;
  }
  .team-side.home { justify-content: flex-end; }
  .team-side.away { justify-content: flex-start; }

  .team-logo-wrap {
    width: 40px; height: 40px; flex-shrink: 0;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--black);
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
  }
  .team-logo { width: 100%; height: 100%; object-fit: contain; padding: 4px; }
  .team-logo-fallback {
    font-size: var(--fs-eyebrow); font-weight: var(--fw-medium);
    color: var(--text-muted); letter-spacing: var(--ls-eyebrow);
    align-items: center; justify-content: center;
  }
  .team-name {
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    color: var(--text);
    white-space: normal;
    word-break: break-word;
    line-height: var(--lh-snug);
  }

  .score-center {
    display: flex; align-items: center; gap: var(--sp-1); flex-shrink: 0;
  }
  /* NOT: .score-big font-size'ı (1.6rem) bilinçli istisna — skorlar ölçek
     tokenlarının dışında tutuluyor; font-variant-numeric de öyle. */
  .score-big { font-variant-numeric: tabular-nums; font-size: 1.6rem; font-weight: 900; color: var(--green-bright); line-height: var(--lh-tight); }
  .score-sep { font-size: var(--fs-md); color: var(--text-muted); }

  /* Sonuç rozeti: mobilde de görünür (§4.5.7) */
  .match-result { display: flex; justify-content: center; }
  .result-badge {
    width: 36px; height: 36px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: var(--fs-eyebrow); font-weight: var(--fw-bold);
    color: var(--text-muted);
    border: 1px solid var(--border);
  }
  /* Sonuç ayrımı görsel YAPI ile: galibiyet dolgu, beraberlik/mağlubiyet
     wash zemin + 1px çerçeve. Harf (G/B/M) her zaman kalır; renk tek
     ayrım aracı olmaz. Kırmızı 36px rozetin içinde kalır, karta taşmaz. */
  .result-badge.win  { background: var(--green);        color: var(--text);    border-color: var(--green); }
  .result-badge.draw { background: var(--amber-wash);   color: var(--amber);   border-color: var(--amber); }
  .result-badge.loss { background: var(--kirmizi-wash); color: var(--kirmizi); border-color: var(--kirmizi); }

  /* ───────────────────────────────────────────────
     Responsive — mobil
     NOT: medya sorguları taban stillerden SONRA gelmeli,
     yoksa eşit özgüllükteki taban kurallar bunları eziyor.
  ─────────────────────────────────────────────── */
  @media (max-width: 640px) {
    .match-card {
      grid-template-columns: 1fr auto;
      gap: var(--sp-2);
      padding: var(--sp-2);
    }
    .match-meta-left { grid-column: 1 / -1; }
    .match-teams { gap: var(--sp-1); }
    .team-side {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--sp-1);
      min-width: 0;
    }
    .team-side.home,
    .team-side.away { justify-content: flex-start; }
    .team-name {
      font-size: var(--fs-eyebrow);
      white-space: normal;
      max-width: 90px;
      line-height: var(--lh-snug);
    }
  }
</style>
