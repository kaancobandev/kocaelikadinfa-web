---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import { supabase, type GalleryItem } from '../lib/supabase';
import { img, imgSet } from '../lib/img';

const [{ data: settingsData }, { data: galleryData }] = await Promise.all([
  supabase.from('hero_settings').select('image_url').eq('id', 2).maybeSingle(),
  supabase.from('pilot_gallery').select('*').order('sort_order', { ascending: true }),
]);

const heroImage: string = settingsData?.image_url ?? '/pilot-hero.jpg';
const photos: GalleryItem[] = galleryData ?? [];
---

<Layout
  title="Pilot Takım — Kocaeli Kadın Futbol Kulübü"
  description="Kocaeli Kadın Futbol Kulübü Pilot Takımı: geleceğin yıldız adayları, kadrosu ve fotoğraflarıyla. Kocaeli'de kadın futbolunun temeli."
>
  <Navbar />

  <main id="icerik" tabindex="-1">

    <PageHero
      tag="Takımlar"
      title="Pilot Takım — Kadınlar 3. Ligi"
      description="Tutkuyla çalışan, disiplinle oynayan ve sahada hiçbir zaman pes etmeyen bir kadro."
      image={img(heroImage, 1600, 70)}
      imageSet={imgSet(heroImage, [800, 1200, 1600], 70)}
    />

    <!-- Yazı: tek paragraf -->
    <section class="band story-section">
      <div class="band-inner">
        <h2>Nasıl Oynuyoruz?</h2>
        <p>
          Pilot takımımız Kocaeli Gölcük İdmanocağı ile sporcularımıza Kadınlar 3. Lig'de forma giyme fırsatı sunuyoruz. Kocaeli Kadın Futbol Akademisi olarak, altyapımızda yetişen sporcularımızın gelişimlerini destekliyor; onları tecrübe kazandırarak Türk kadın futboluna kazandırıyoruz.
        </p>
        <!-- /a-takim'daki bağlantının karşılığı (üçüncül) -->
        <a href="/a-takim" class="link-tertiary">A Takım — Kadınlar 1. Ligi →</a>
      </div>
    </section>

    <!-- Fotoğraflar: veri yoksa bölüm hiç basılmaz -->
    {photos.length > 0 && (
      <section class="band photos-section" id="kareler" aria-label="Pilot Takım'dan kareler">
        <div class="band-inner">
          <span class="eyebrow">Kadınlar 3. Ligi</span>
          <h2>Sahadan Kareler</h2>
          <div class="partner-logo-wrap">
            <img src="/idmanocağı_futbol_kulübü.jpeg" alt="Kocaeli Gölcük İdmanocağı FK" class="partner-logo" width="64" height="64" loading="lazy" />
          </div>
          <div class="photos-grid">
            {photos.map(p => (
              <div class="card">
                <span class="card-media">
                  <img
                    src={img(p.image_url, 400)}
                    srcset={imgSet(p.image_url, [400, 800])}
                    sizes="(max-width: 767px) 100vw, (max-width: 1119px) 50vw, 33vw"
                    alt={p.caption ?? 'Sahadan kareler'}
                    loading="lazy"
                    decoding="async"
                  />
                </span>
                {/* Altyazı şeridi her zaman basılır; boşsa yüksekliğini korur */}
                <span class="card-meta">{p.caption ?? ''}</span>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Çağrı -->
    <section class="band cta-section">
      <div class="band-inner">
        <h2>Sen de Aramıza Katıl</h2>
        <p>Pilot takımımıza seçmelere katılmak ya da destek vermek istiyorsan bize ulaş.</p>
        <!-- Dolgulu buton yok: bu sayfa bilgilendirir, /aramiza-katil'e üçüncül bağlantıyla yollar (§4.4) -->
        <a href="/aramiza-katil" class="link-tertiary">Bize ulaş →</a>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style>
  .story-section,
  .photos-section,
  .cta-section { border-top: 1px solid var(--border); }
  /* Gövde ölçüsü ~66 karakter/satır (global p kuralıyla aynı, burada açık) */
  .story-section p { max-width: var(--measure-text); }

  /* Üçüncül bağlantı: soluk düz metin, vurgu rengi yok */
  .link-tertiary {
    display: inline-block;
    font-size: var(--fs-sm);
    color: var(--text-muted);
    text-decoration: none;
    transition: color .2s;
  }
  .link-tertiary:hover { color: var(--text); }
  .link-tertiary:focus-visible { outline: 2px solid var(--green-bright); outline-offset: 3px; }

  /* Partner arması: h2'den SONRA, en çok 64px, sola hizalı — sayfanın en
     büyük görsel öğesi başka bir kulübün arması olamaz (§4.5.11) */
  .partner-logo-wrap { display: flex; }
  .partner-logo {
    width: 64px;
    height: 64px;
    object-fit: contain;
    border-radius: 50%;
    border: 1px solid var(--border);
    padding: 4px;
  }

  /* Izgara formülü (§2.3): 3'ten az öğede kartlar sola yığılır */
  .photos-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(min(280px, 100%), 1fr));
    gap: var(--sp-3);
  }
  @media (max-width: 1119px) { .photos-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 767px)  { .photos-grid { grid-template-columns: 1fr; } }
</style>
