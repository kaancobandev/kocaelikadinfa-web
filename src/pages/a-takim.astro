---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import { supabase, type GalleryItem } from '../lib/supabase';
import { img, imgSet } from '../lib/img';

// hero_settings satırları: 1 = ana sayfa, 2 = pilot takım, 3 = A takım
const [{ data: settingsData }, { data: galleryData }] = await Promise.all([
  supabase.from('hero_settings').select('image_url').eq('id', 3).maybeSingle(),
  supabase.from('a_takim_gallery').select('*').order('sort_order', { ascending: true }),
]);

// Panelden görsel yüklenmediyse depodaki varsayılan kullanılır
const heroImage: string = settingsData?.image_url ?? '/a-takim-hero.jpeg';
const photos: GalleryItem[] = galleryData ?? [];
---

<Layout
  title="A Takım — Kocaeli Kadın Futbol Kulübü"
  description="Kocaeli Kadın Futbol Kulübü A Takımı: kadrosu, fotoğrafları ve sahadaki mücadelesi. Süper Lig yolunda Kocaeli'nin gururu."
>
  <Navbar />

  <main id="icerik" tabindex="-1" class="at-page">

    <PageHero
      tag="A Takım"
      title="Kocaeli'nin"
      accent="Gururu"
      description="Altyapıya verdiğimiz önem ve genç oyuncularımıza duyduğumuz güvenle, kadın futbolunda sürdürülebilir başarı hedefliyoruz."
      minHeight="52vh"
      image={img(heroImage, 1600, 70)}
      align="right"
    />

    <!-- Yazı -->
    <section class="story-section">
      <div class="story-inner">
        <h2>Takımımız Hakkında</h2>
        <div class="story-text">
          <p>
            Kadınlar 1. Lig'inin en genç, tamamen yerli ve yabancı oyuncu bulundurmayan tek takımı olarak; başarımızı kendi altyapımızdan yetişen genç yeteneklere verdiğimiz değerle inşa ediyoruz.
          </p>
          <p>
            Kocaeli Kadın Futbol Akademisi olarak geleceği kendi sporcularımızla yazıyoruz.
          </p>
        </div>

      </div>
    </section>

    <!-- Fotoğraflar -->
    {photos.length > 0 && (
      <section class="photos-section">
        <h2 class="photos-title">Sahadan Kareler</h2>
        <div class="photos-grid">
          {photos.map((p, i) => (
            <figure class="photo-card">
              <div class="photo-media">
                <img
                  src={img(p.image_url, 800)}
                  srcset={imgSet(p.image_url)}
                  sizes="(max-width: 768px) 100vw, 33vw"
                  alt={p.caption ?? ''}
                  {/* İlk satır zaten ekranda; ertelemek yerine hemen insin */}
                  loading={i < 3 ? 'eager' : 'lazy'}
                  fetchpriority={i < 3 ? 'high' : undefined}
                  decoding="async"
                />
              </div>
              {p.caption && <figcaption>{p.caption}</figcaption>}
            </figure>
          ))}
        </div>
      </section>
    )}

    <!-- CTA -->
    <section class="cta-section">
      <h2>A Takımımıza Katıl</h2>
      <p>Kadromuzda yer almak istiyorsan seçmelerimizi takip et ve başvurunu yap.</p>
      <a href="/aramiza-katil" class="btn-primary">Başvuru Yap</a>
    </section>

  </main>

  <Footer />
</Layout>

<style>
  /* ── Yazı ── */
  .story-section {
    padding: 6rem 8%;
    background: var(--dark);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .story-inner { max-width: 820px; margin-left: auto; }

  .story-section h2 {
    font-size: var(--fs-xl);
    font-weight: var(--fw-bold);
    margin-bottom: 2rem;
    display: inline-block;
  }
  .story-section h2::after {
    content: '';
    display: block;
    width: 50px; height: 3px;
    background: var(--green-bright);
    margin-top: .4rem;
    border-radius: var(--r-sm);
  }

  .story-text { display: flex; flex-direction: column; gap: 1.2rem; }
  .story-text p { font-size: var(--fs-base); color: var(--text-body); line-height: var(--lh-body); }

  /* ── Fotoğraflar ── */
  .photos-section { padding: 5rem 8%; background: var(--black); }

  .photos-title {
    font-size: var(--fs-xl);
    font-weight: var(--fw-bold);
    margin-bottom: 2.5rem;
    display: inline-block;
  }
  .photos-title::after {
    content: '';
    display: block;
    width: 50px; height: 3px;
    background: var(--green-bright);
    margin-top: .4rem;
    border-radius: var(--r-sm);
  }

  /* Izgara — satır satır soldan sağa. Kolon bazlı masonry'de (column-count)
     belge sırası ekrandaki sırayla örtüşmediği için üstteki fotoğraflar en
     son, alttakiler ilk iniyordu. */
  .photos-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.2rem;
    align-items: start;
  }
  @media (max-width: 960px) { .photos-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .photos-grid { grid-template-columns: 1fr; } }

  .photo-card {
    border-radius: var(--r-md);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--card-bg);
    transition: transform .3s, box-shadow .3s;
  }
  .photo-card:hover { transform: translateY(-4px); box-shadow: 0 12px 32px rgba(0,0,0,.5); }
  .photo-media { overflow: hidden; }
  /* Izgarada satırlar hizalı dursun diye ortak oran; yükseklik baştan belli
     olduğu için görsel inerken sayfa kaymıyor. */
  .photo-card img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    height: auto;
    object-fit: cover;
    object-position: center 40%;
    transition: transform .4s;
  }
  .photo-card:hover img { transform: scale(1.03); }
  figcaption { background: var(--card-bg); padding: .8rem 1rem; font-size: var(--fs-sm); color: var(--text-muted); font-weight: var(--fw-medium); }

  /* ── CTA ── */
  .cta-section {
    padding: 5rem 8%;
    background: var(--dark);
    border-top: 1px solid var(--border);
    text-align: center;
  }
  .cta-section h2 { font-size: var(--fs-xl); font-weight: var(--fw-bold); margin-bottom: .8rem; }
  .cta-section p  { color: var(--text-body); margin-bottom: 2rem; }
</style>
