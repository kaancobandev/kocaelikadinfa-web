---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import Lightbox from '../components/Lightbox.astro';
import { supabase, type GalleryItem } from '../lib/supabase';
import { img, imgSet } from '../lib/img';

// hero_settings satırları: 1 = ana sayfa, 2 = pilot takım, 3 = A takım
const [{ data: settingsData }, { data: galleryData }] = await Promise.all([
  supabase.from('hero_settings').select('image_url').eq('id', 3).maybeSingle(),
  supabase.from('a_takim_gallery').select('*').order('sort_order', { ascending: true }),
]);

// Panelden görsel yüklenmediyse depodaki varsayılan kullanılır
const heroImage: string = settingsData?.image_url ?? '/a-takim-hero.jpeg';
const photos: GalleryItem[] = galleryData ?? [];
---

<Layout
  title="A Takım — Kocaeli Kadın Futbol Kulübü"
  description="Kocaeli Kadın Futbol Kulübü A Takımı: kadrosu, fotoğrafları ve sahadaki mücadelesi. Süper Lig yolunda Kocaeli'nin gururu."
>
  <Navbar />

  <main id="icerik" tabindex="-1">

    <PageHero
      tag="Takımlar"
      title="A Takım — Kadınlar 1. Ligi"
      description="Altyapıya verdiğimiz önem ve genç oyuncularımıza duyduğumuz güvenle, kadın futbolunda sürdürülebilir başarı hedefliyoruz."
      image={img(heroImage, 1600, 70)}
      imageSet={imgSet(heroImage, [800, 1200, 1600], 70)}
    />

    <!-- Yazı: tek paragraf -->
    <section class="band story-section">
      <div class="band-inner">
        <h2>Takımımız Hakkında</h2>
        <p>
          Kadınlar 1. Lig'inin en genç, tamamen yerli ve yabancı oyuncu bulundurmayan tek takımı olarak; başarımızı kendi altyapımızdan yetişen genç yeteneklere verdiğimiz değerle inşa ediyoruz. Kocaeli Kadın Futbol Akademisi olarak geleceği kendi sporcularımızla yazıyoruz.
        </p>
        <!-- Pilot Takım menüde değil; ona buradan gidiliyor (üçüncül bağlantı) -->
        <a href="/pilot-takim" class="link-tertiary">Pilot Takım — Kadınlar 3. Ligi →</a>
      </div>
    </section>

    <!-- Fotoğraflar: veri yoksa bölüm hiç basılmaz -->
    {photos.length > 0 && (
      <section class="band photos-section" id="kareler" aria-label="A Takım'dan kareler">
        <div class="band-inner">
          <span class="eyebrow">Kadınlar 1. Ligi</span>
          <h2>Sahadan Kareler</h2>
          <div class="photos-grid">
            {photos.map((p, i) => (
              <button type="button" class="card" data-lb-src={img(p.image_url, 1600)} data-lb-altyazi={p.caption ?? ''}>
                <span class="card-media">
                  <img
                    src={img(p.image_url, 400)}
                    srcset={imgSet(p.image_url, [400, 800])}
                    sizes="(max-width: 767px) 100vw, (max-width: 1119px) 50vw, 33vw"
                    alt={p.caption ?? 'Sahadan kareler'}
                    {/* İlk satır zaten ekranda; ertelemek yerine hemen insin */}
                    loading={i < 3 ? 'eager' : 'lazy'}
                    fetchpriority={i < 3 ? 'high' : undefined}
                    decoding="async"
                  />
                </span>
                {/* Altyazı şeridi her zaman basılır; boşsa yüksekliğini korur */}
                <span class="card-meta">{p.caption ?? ''}</span>
              </button>
            ))}
          </div>
          <Lightbox />
        </div>
      </section>
    )}

    <!-- Çağrı -->
    <section class="band cta-section">
      <div class="band-inner">
        <h2>A Takımımıza Katıl</h2>
        <p>Kadromuzda yer almak istiyorsan seçmelerimizi takip et ve başvurunu yap.</p>
        <!-- Dolgulu buton yok: bu sayfa bilgilendirir, /aramiza-katil'e üçüncül bağlantıyla yollar (§4.4) -->
        <a href="/aramiza-katil" class="link-tertiary">Seçmeler için bize ulaşın →</a>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style>
  .story-section,
  .photos-section,
  .cta-section { border-top: 1px solid var(--border); }
  /* Gövde ölçüsü ~66 karakter/satır (global p kuralıyla aynı, burada açık) */
  .story-section p { max-width: var(--measure-text); }

  /* Üçüncül bağlantı: soluk düz metin, vurgu rengi yok */
  .link-tertiary {
    display: inline-block;
    font-size: var(--fs-sm);
    color: var(--text-muted);
    text-decoration: none;
    transition: color .2s;
  }
  .link-tertiary:hover { color: var(--text); }
  .link-tertiary:focus-visible { outline: 2px solid var(--green-bright); outline-offset: 3px; }

  /* Izgara formülü (§2.3) */
  .photos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr));
    gap: var(--sp-3);
  }
</style>
