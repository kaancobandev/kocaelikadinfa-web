---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import KimlikSeridi from '../components/KimlikSeridi.astro';
import Scores from '../components/Scores.astro';
import ContentCards from '../components/ContentCards.astro';
import TeamSection from '../components/TeamSection.astro';
import VideoSection from '../components/VideoSection.astro';
import Footer from '../components/Footer.astro';
import { supabase, type NewsItem } from '../lib/supabase';

/* Haber sorgusu TEK yerde: eskiden Hero (limit 4) ve ContentCards (limit 3)
   aynı sıralamayla ayrı ayrı çekiyor, ilk üç haber sayfada iki kez
   basılıyordu. Hero en yeni kaydı manşet bağlantısı olarak kullanır,
   kalan üçü kart olarak ContentCards'a geçer. */
const { data } = await supabase
  .from('news')
  .select('*')
  .order('id', { ascending: false })
  .limit(4);

const haberler: NewsItem[] = data ?? [];
const [enYeni, ...kalanlar] = haberler;
---

<Layout
  title="Kocaeli Kadın Futbol Kulübü | Resmi Web Sitesi"
  description="Kocaeli Kadın Futbol Kulübü resmi sitesi. A Takım, Pilot Takım ve akademi, güncel maç sonuçları, haberler ve videolar. Kocaeli'de kadın futbolunun adresi."
  intro
>
  <Navbar />
  <main id="icerik" tabindex="-1">
    <Hero enYeni={enYeni} />
    <KimlikSeridi />
    <Scores />
    <ContentCards items={kalanlar} />
    <TeamSection />
    <VideoSection />
  </main>
  <Footer />
</Layout>
