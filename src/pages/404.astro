---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';

// Menüyle aynı sıra ve etiketler (Navbar.astro); ek olarak / ve /pilot-takim.
const links = [
  { href: '/',                        label: 'Ana Sayfa',      desc: 'Son haberler ve maç sonuçları' },
  { href: '/a-takim',                 label: 'Takımlar',       desc: 'Kadromuz ve sahadan kareler' },
  { href: '/pilot-takim',             label: 'Pilot Takım',    desc: 'Geleceğin yıldız adayları' },
  { href: '/akademi',                 label: 'Akademi',        desc: 'Altyapı ve genç yetenekler' },
  { href: '/mac-gecmisi',             label: 'Sonuçlar',       desc: 'Tüm maç sonuçlarımız' },
  { href: '/haberler',                label: 'Haberler',       desc: 'Kulüpten son gelişmeler' },
  { href: '/antrenmanlardan-kareler', label: 'Galeri',         desc: 'Fotoğraf ve videolar' },
  { href: '/aramiza-katil',           label: 'Aramıza Katıl',  desc: 'Başvuru ve iletişim' },
];
---

<Layout
  title="Sayfa Bulunamadı — Kocaeli Kadın Futbol Kulübü"
  description="Aradığınız sayfa bulunamadı. Kocaeli Kadın Futbol Kulübü sitesinde gezinmeye devam edin."
  noindex={true}
>
  <Navbar />

  <main id="icerik" tabindex="-1">
    <PageHero
      tag="404"
      title="Bu Top"
      accent="Auta Gitti"
      description="Aradığın sayfa taşınmış ya da hiç var olmamış olabilir. Aşağıdan devam edebilirsin."
      maxTitle="4.6rem"
    >
      <!-- İkincil bağlantı: dolgulu buton yalnız /, /akademi ve /aramiza-katil'de -->
      <a href="/" class="nf-cta">Ana Sayfaya Dön →</a>
    </PageHero>

    <section class="band nf-links">
      <div class="band-inner">
        <h2>Belki bunları arıyordun</h2>
        <div class="nf-grid">
          {links.map(l => (
            <a href={l.href} class="card">
              <span class="card-title">{l.label}</span>
              <span class="card-meta">{l.desc}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .nf-cta {
    display: inline-block;
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    color: var(--green-bright);
    text-decoration: none;
  }
  .nf-cta:hover { color: var(--text); }
  .nf-cta:focus-visible { outline: 2px solid var(--green-bright); outline-offset: 3px; }

  .nf-links { border-top: 1px solid var(--border); }

  /* Izgara formülü (§2.3): auto-fill + min() — dar ekranda taşmaz */
  .nf-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr));
    gap: var(--sp-3);
  }
</style>
