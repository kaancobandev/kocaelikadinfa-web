---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';

/* ═══════════════════════════════════════════════════════════════════════
   ⚠️  BURAYI GÜNCELLE — sayfadaki tüm değişken bilgi bu blokta.

   Aşağıdaki alanlardan BOŞ bırakılanlar sayfada gösterilmez; onun yerine
   "bilgi için bize ulaşın" yönlendirmesi çıkar. Yani yanlış/uydurma bilgi
   yayına çıkmaz, sadece eksik kalır.

   Doldurulması gerekenler:
     • grupların `gunler` alanları  (ör. "Salı & Perşembe 18:00–19:30")
     • sahaların `adres` ve `mapsQuery` alanları
     • ucretBilgisi  (boşsa SSS'te "iletişime geçin" yazar)
   ═══════════════════════════════════════════════════════════════════════ */

const TELEFON      = '+905326944509';
const TELEFON_GOSTER = '+90 532 694 45 09';
const EPOSTA       = 'kocaelikadinfa@gmail.com';
const ON_KAYIT_URL = 'https://kocaelikadinfk.sporakademik.com/OnKayit';

/** Ücret bilgisi. Boş bırakılırsa SSS'te iletişim yönlendirmesi görünür. */
const ucretBilgisi = '';

/** Yaş grupları / takımlar. `gunler` boşsa kartta gün-saat satırı çıkmaz. */
const gruplar = [
  {
    ad: 'Akademi',
    yas: '4 – 16 yaş',
    aciklama: 'Futbola yeni başlayanlar için temel eğitim. Önceden deneyim gerekmez; akademik eğitimli antrenörler eşliğinde eğlenerek gelişim.',
    gunler: '',
  },
  {
    ad: 'Pilot Takım',
    yas: 'Altyapıdan seçilen sporcular',
    aciklama: 'Kocaeli Gölcük İdmanocağı iş birliğiyle Kadınlar 3. Lig\'de forma giyme ve maç tecrübesi kazanma fırsatı.',
    gunler: '',
  },
  {
    ad: 'A Takım',
    yas: 'Seçmeyle',
    aciklama: 'Kadınlar 1. Lig kadromuz. Tamamen kendi altyapımızdan yetişen sporculardan oluşuyor; seçmeler dönemsel olarak duyurulur.',
    gunler: '',
  },
];

/** Antrenman sahaları. `adres` boşsa yalnızca saha adı gösterilir. */
const sahalar = [
  { ad: 'İzmit Seka Halı Saha',          ilce: 'İzmit',  adres: '', mapsQuery: 'Seka Halı Saha İzmit Kocaeli' },
  { ad: 'Gölcük Kavaklı Deniz Halı Saha', ilce: 'Gölcük', adres: '', mapsQuery: 'Kavaklı Deniz Halı Saha Gölcük Kocaeli' },
  { ad: 'Yahya Kaptan',                   ilce: 'İzmit',  adres: '', mapsQuery: 'Yahya Kaptan Spor Tesisi İzmit Kocaeli' },
];

const adimlar = [
  { no: '1', baslik: 'Ön kayıt formunu doldur', metin: 'Sporcu ön kayıt formunu doldurarak bize ulaş. Birkaç dakika sürüyor.' },
  { no: '2', baslik: 'Seni arayalım',           metin: 'Yaşına ve seviyene uygun grubu belirleyip antrenman gün ve saatini birlikte planlayalım.' },
  { no: '3', baslik: 'Deneme antrenmanına gel', metin: 'Sahada bizi tanı, takımla tanış. Beğenirsen kayıt işlemlerini tamamlıyoruz.' },
];

const getirilecekler = [
  'Krampon (ayakkabı)',
  'Rahat spor kıyafeti — şort ve tişört',
  'Futbol çorabı ve tekmelik',
  'Su matarası',
  'Havlu ve yedek tişört',
];

/* SSS. "Ne getirmeli" listesi ayrı bir bölüm değil, buradaki bir soru
   (bölüm sayısı ≤4, §4.5.14); içerik aynen duruyor. */
const sss: { s: string; c: string; liste?: string[] }[] = [
  {
    s: 'Hiç futbol oynamamış biri katılabilir mi?',
    c: 'Evet. Akademimiz futbola yeni başlayan sporcuları temel seviyeden alıyor; önceden deneyim şartı yok. Antrenörlerimiz her sporcunun seviyesine göre program uyguluyor.',
  },
  {
    s: 'Hangi yaş aralığındaki sporcuları kabul ediyorsunuz?',
    c: 'Akademi gruplarımız 4–16 yaş arasındaki sporculara açık. Üst yaş kategorileri için Pilot Takım ve A Takım seçmelerimizi takip edebilirsin.',
  },
  {
    s: 'Antrenmanlar nerede yapılıyor?',
    c: 'İzmit Seka Halı Saha, Gölcük Kavaklı Deniz Halı Saha ve Yahya Kaptan tesislerinde çalışıyoruz. Sana en yakın sahayı birlikte belirliyoruz.',
  },
  {
    s: 'Aidat / ücret ne kadar?',
    c: ucretBilgisi ||
       `Güncel ücret ve ödeme seçenekleri dönemsel olarak değişebiliyor. En doğru bilgi için ${TELEFON_GOSTER} numaralı telefondan bize ulaşabilirsin.`,
  },
  {
    s: 'Kayıt için hangi evraklar gerekiyor?',
    c: 'Gerekli evraklar yaş grubuna göre değişiyor. Ön kayıt formunu doldurduktan sonra sizi arayıp süreci adım adım anlatıyoruz.',
  },
  {
    s: 'Velim antrenmanları izleyebilir mi?',
    c: 'Antrenman ziyaretleri ve veli bilgilendirmesi için bizimle iletişime geçebilirsin; sahaya göre uygulama değişebiliyor.',
  },
  {
    s: 'İlk antrenmana ne getirmeli?',
    c: 'Deneme antrenmanına gelirken yanında bulunması gerekenler. Eksiğin varsa sorun değil, bize haber ver.',
    liste: getirilecekler,
  },
];

const gunBilgisiVar = gruplar.some(g => g.gunler);
---

<Layout
  title="Aramıza Katıl — Kocaeli Kadın Futbol Kulübü"
  description="Kocaeli Kadın Futbol Kulübü'ne nasıl katılırsın? Yaş grupları, antrenman sahaları, kayıt adımları ve sık sorulan sorular. 4–16 yaş akademi kayıtları açık."
>
  <Navbar />

  <main id="icerik" tabindex="-1" class="join-page">

    <PageHero
      tag="Bize Katıl"
      title="Aramıza"
      accent="Katıl"
      description="Futbola yeni başlıyor ya da kendini geliştirmek istiyorsan doğru yerdesin. 4–16 yaş akademi kayıtlarımız açık."
      maxTitle="5rem"
    >
        <div class="hero-actions">
          <a href={ON_KAYIT_URL} target="_blank" rel="noopener noreferrer" class="btn-primary">Ön Kayıt Formunu Doldur</a>
          <a href={`tel:${TELEFON}`} class="btn-ghost">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.6 19.79 19.79 0 0 1 1.6 5a2 2 0 0 1 1.95-2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 10.9a16 16 0 0 0 6 6l.92-.92a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 18.18v-1.26z"/>
            </svg>
            {TELEFON_GOSTER}
          </a>
        </div>
    </PageHero>

    <!-- ── Kimler katılabilir ── -->
    <section class="band groups-section">
      <div class="band-inner">
        <span class="eyebrow">Kimler Katılabilir?</span>
        <h2>Yaş Grupları ve Takımlar</h2>
        <p>Her seviyeye uygun bir grubumuz var. Hangisine uygun olduğundan emin değilsen bize sor, birlikte belirleyelim.</p>

        <div class="groups-grid">
          {gruplar.map(g => (
            <div class="group-card">
              <span class="group-yas">{g.yas}</span>
              <h3>{g.ad}</h3>
              <p>{g.aciklama}</p>
              {/* Gün-saat bilgisi boşsa satır hiç basılmaz; tek not bölümün altında (§4.5.13) */}
              {g.gunler && <p class="group-gun"><strong>Antrenman:</strong> {g.gunler}</p>}
            </div>
          ))}
        </div>

        {!gunBilgisiVar && (
          <p class="note">
            Antrenman gün ve saatleri gruba ve sahaya göre değişiyor.
            <a href={`tel:${TELEFON}`}>{TELEFON_GOSTER}</a> numarasından güncel programı öğrenebilirsin.
          </p>
        )}
      </div>
    </section>

    <!-- ── Sahalar ── -->
    <section class="band fields-section">
      <div class="band-inner">
        <span class="eyebrow">Nerede Antrenman Yapıyoruz?</span>
        <h2>Antrenman Sahalarımız</h2>

        <div class="fields-grid">
          {sahalar.map(s => (
            <a
              class="field-card"
              href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(s.mapsQuery)}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="field-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                  <circle cx="12" cy="10" r="3"/>
                </svg>
              </span>
              <div class="field-body">
                <h3>{s.ad}</h3>
                <span class="field-ilce">{s.ilce}</span>
                {s.adres && <span class="field-adres">{s.adres}</span>}
              </div>
              <span class="field-map">Haritada aç →</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Adımlar ── -->
    <section class="band steps-section">
      <div class="band-inner">
        <span class="eyebrow">Nasıl Başlarım?</span>
        <h2>3 Adımda Aramıza Katıl</h2>

        <ol class="steps">
          {adimlar.map(a => (
            <li class="step">
              <span class="step-no">{a.no}</span>
              <div>
                <h3>{a.baslik}</h3>
                <p>{a.metin}</p>
              </div>
            </li>
          ))}
        </ol>

        <!-- Başvuru kanalları aynı bölümde: ikinci dolgulu buton yok (§4.5.12) -->
        <div class="options-grid">
          <a href={ON_KAYIT_URL} target="_blank" rel="noopener noreferrer" class="option-card">
            <div class="option-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
                <line x1="16" y1="13" x2="8" y2="13"/>
                <line x1="16" y1="17" x2="8" y2="17"/>
                <polyline points="10 9 9 9 8 9"/>
              </svg>
            </div>
            <div class="option-body">
              <h3>Online Başvuru</h3>
              <p>Sporcu ön kayıt formunu doldurarak hemen başvurunu tamamla.</p>
            </div>
            <div class="option-arrow">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
            </div>
          </a>

          <a href={`https://wa.me/${TELEFON.replace('+', '')}`} target="_blank" rel="noopener noreferrer" class="option-card option-whatsapp">
            <div class="option-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
              </svg>
            </div>
            <div class="option-body">
              <h3>WhatsApp ile İletişim</h3>
              <p>Sorularını sormak ya da bilgi almak için bize WhatsApp'tan ulaş.</p>
              <span class="phone-num">{TELEFON_GOSTER}</span>
            </div>
            <div class="option-arrow">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
            </div>
          </a>
        </div>

        <p class="contact-alt">
          E-posta: <a href={`mailto:${EPOSTA}`}>{EPOSTA}</a>
          <span class="dot">•</span>
          Telefon: <a href={`tel:${TELEFON}`}>{TELEFON_GOSTER}</a>
        </p>
      </div>
    </section>

    <!-- ── SSS ── -->
    <section class="band faq-section">
      <div class="band-inner">
        <span class="eyebrow">Merak Edilenler</span>
        <h2>Sık Sorulan Sorular</h2>

        <div class="faq-list">
          {sss.map(item => (
            <details class="faq-item">
              <summary>
                {item.s}
                <svg class="faq-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"/>
                </svg>
              </summary>
              <p>{item.c}</p>
              {item.liste && (
                <ul class="faq-liste">
                  {item.liste.map(x => <li>{x}</li>)}
                </ul>
              )}
            </details>
          ))}
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style>
  .hero-actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 2rem; }
  /* İkincil biçim: zeminsiz, çerçevesiz metin bağlantı */
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: .55rem;
    color: var(--green-bright);
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    text-decoration: none;
    font-variant-numeric: tabular-nums;
    transition: color .2s;
  }
  .btn-ghost:hover { color: var(--text); }
  .btn-ghost:focus-visible { outline: 2px solid var(--green-bright); outline-offset: 3px; }

  /* ── Ortak bölüm: kap ve ritim global .band/.band-inner'dan gelir;
     burada yalnız bölümleri ayıran ince çizgi ── */
  .groups-section, .fields-section, .steps-section, .faq-section {
    background: var(--black);
    border-top: 1px solid var(--border);
  }

  .note {
    margin-top: 1.5rem;
    font-size: var(--fs-sm);
    color: var(--text-body);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    padding: .9rem 1.1rem;
  }
  .note a { color: var(--green-bright); font-weight: var(--fw-bold); text-decoration: none; }
  .note a:hover { text-decoration: underline; }

  /* ── Gruplar ── */
  .groups-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr));
    gap: var(--sp-3);
  }

  .group-card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.6rem 1.5rem 1.8rem;
    display: flex;
    flex-direction: column;
    gap: .6rem;
    transition: border-color .15s ease;
  }
  .group-card:hover { border-color: var(--border-strong); }

  .group-yas {
    align-self: flex-start;
    font-size: var(--fs-eyebrow); font-weight: var(--fw-medium); letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .group-card h3 { font-size: var(--fs-md); font-weight: var(--fw-bold); }
  .group-card p  { font-size: var(--fs-sm); color: var(--text-body); line-height: var(--lh-body); }
  .group-card .group-gun {
    margin-top: auto;
    padding-top: var(--sp-2);
    border-top: 1px solid var(--border);
    font-size: var(--fs-sm);
  }
  .group-gun strong { color: var(--text); }

  /* ── Sahalar ── */
  .fields-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr));
    gap: var(--sp-3);
  }

  .field-card {
    display: flex;
    flex-direction: column;
    gap: .7rem;
    padding: 1.5rem;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--text);
    transition: border-color .15s ease;
  }
  .field-card:hover { border-color: var(--border-strong); }
  .field-card:focus-visible { outline: 2px solid var(--green-bright); outline-offset: 3px; }

  .field-icon {
    width: 42px; height: 42px;
    border-radius: var(--r-md);
    border: 1px solid var(--border);
    display: flex; align-items: center; justify-content: center;
    color: var(--text-muted);
  }
  .field-body { display: flex; flex-direction: column; gap: .25rem; }
  .field-body h3 { font-size: var(--fs-base); font-weight: var(--fw-bold); }
  .field-ilce { font-size: var(--fs-eyebrow); color: var(--text-muted); font-weight: var(--fw-medium); letter-spacing: .5px; }
  .field-adres { font-size: var(--fs-sm); color: var(--text-muted); line-height: 1.5; }
  .field-map {
    margin-top: auto;
    font-size: var(--fs-eyebrow); font-weight: var(--fw-medium);
    color: var(--text-muted);
  }

  /* ── Adımlar ── */
  .steps {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr));
    gap: var(--sp-3);
  }

  .step { display: flex; gap: 1rem; align-items: flex-start; }
  /* Adım numarası: yeşil daire değil, büyük soluk rakam (sayfada tek dolgu butondur) */
  .step-no {
    flex-shrink: 0;
    width: 2.5rem;
    font-size: var(--fs-lg); font-weight: var(--fw-bold);
    color: var(--text-muted);
    line-height: var(--lh-tight);
    font-variant-numeric: tabular-nums;
  }
  .step h3 { margin-bottom: var(--sp-1); }
  .step p  { font-size: var(--fs-sm); color: var(--text-body); line-height: var(--lh-body); }

  /* ── SSS ── */
  /* SSS iki kolon — tek kolonda sağ yarı boş kalıyordu */
  .faq-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-content: start;
    gap: var(--sp-2);
  }
  @media (max-width: 767px) { .faq-list { grid-template-columns: 1fr; } }

  .faq-item {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color .15s ease;
  }
  .faq-item[open] { border-color: var(--border-strong); }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.3rem;
    cursor: pointer;
    font-size: var(--fs-base);
    font-weight: var(--fw-bold);
    list-style: none;
    transition: color .2s;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary:focus-visible { outline: 2px solid var(--green-bright); outline-offset: -2px; }

  .faq-chevron { flex-shrink: 0; color: var(--text-muted); transition: transform .25s; }
  .faq-item[open] .faq-chevron { transform: rotate(180deg); }

  .faq-item p {
    padding: 0 1.3rem 1.3rem;
    font-size: var(--fs-base);
    color: var(--text-body);
    line-height: var(--lh-body);
  }
  .faq-liste {
    margin: calc(-1 * var(--sp-2)) 1.3rem 1.3rem;
    padding-left: 1.2em;
    font-size: var(--fs-base);
    color: var(--text-body);
    line-height: var(--lh-body);
  }

  /* ── Başvuru kanalları ── */
  /* İki kart yan yana — 1280px'te sağ taraf boş kalmıyor */
  .options-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--sp-3); }
  @media (max-width: 767px) { .options-grid { grid-template-columns: 1fr; } }

  .option-card {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    background: var(--card-bg);
    border: 1px solid var(--border);
