---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import { supabase, type NewsItem } from '../lib/supabase';
import { img, imgSet } from '../lib/img';
import { newsPath, formatDate, isoDate } from '../lib/news';

/* ── Sayfalama (§7.2): 12 haber/sayfa, sunucu taraflı ?sayfa=N ──────────
   .range() iki ucu da kapsayıcıdır; toplam sayı aynı sorgudan gelir.
   Aralık dışı her değer 1. sayfaya kırpılır.                               */
const SAYFA_BOYU = 12;
const ham = Number(Astro.url.searchParams.get('sayfa'));
const istenen = Number.isFinite(ham) && ham >= 1 ? Math.floor(ham) : 1;

function sayfaGetir(sayfa: number) {
  const bas = (sayfa - 1) * SAYFA_BOYU;
  return supabase
    .from('news')
    .select('*', { count: 'exact' })
    .order('id', { ascending: false })
    .range(bas, bas + SAYFA_BOYU - 1);
}

const sayfaSayisi = (count: number | null) => Math.max(1, Math.ceil((count ?? 0) / SAYFA_BOYU));

let sayfa = istenen;
let sonuc = await sayfaGetir(sayfa);
let toplamSayfa = sayfaSayisi(sonuc.count);
// Aralık dışı: PostgREST ya boş döner ya 416 (error) — iki durumda da 1. sayfa
if (sonuc.error || sayfa > toplamSayfa) {
  sayfa = 1;
  sonuc = await sayfaGetir(1);
  toplamSayfa = sayfaSayisi(sonuc.count);
}
const news: NewsItem[] = sonuc.data ?? [];
const sayfalar = Array.from({ length: toplamSayfa }, (_, i) => i + 1);

// Yalnız 1. sayfada en yeni haber tek başına, tam genişlikte (§4.5.8)
const oneCikan = sayfa === 1 ? news[0] : undefined;
const kalanlar = sayfa === 1 ? news.slice(1) : news;
---

<Layout
  title="Haberler — Kocaeli Kadın Futbol Kulübü"
  description="Kocaeli Kadın Futbol Kulübü'nden son dakika haberleri, maç sonuçları ve duyurular. Kulübün güncel gelişmelerini buradan takip edin."
>
  <Navbar />

  <main id="icerik" tabindex="-1">

    <PageHero
      tag="Son Dakika"
      title="Haber"
      accent="Merkezi"
      description="Kulübümüzden son gelişmeler, maç haberleri ve duyurular."
    >
      {oneCikan && (
        <a href={newsPath(oneCikan)} class="card one-cikan">
          {oneCikan.image_url
            ? (
              <span class="card-media">
                <img
                  src={img(oneCikan.image_url, 800)}
                  srcset={imgSet(oneCikan.image_url, [400, 800, 1200])}
                  sizes="(max-width: 767px) 100vw, 50vw"
                  alt=""
                  fetchpriority="high"
                  decoding="async"
                />
              </span>
            )
            : <span class="card-media foto-yok"></span>
          }
          <span class="one-cikan-body">
            <span class="one-cikan-title">{oneCikan.title}</span>
            <span class="card-meta">
              {formatDate(oneCikan.published_at) && (
                <time datetime={isoDate(oneCikan.published_at)}>{formatDate(oneCikan.published_at)}</time>
              )}
            </span>
          </span>
        </a>
      )}
    </PageHero>

    <!-- Kalan haberler: veri yoksa bölüm hiç basılmaz -->
    {kalanlar.length > 0 && (
      <section class="band news-section" aria-label="Haberler">
        <div class="band-inner">
          <div class="news-grid">
            {kalanlar.map(n => (
              <a href={newsPath(n)} class="card">
                {n.image_url
                  ? (
                    <span class="card-media">
                      <img
                        src={img(n.image_url, 400)}
                        srcset={imgSet(n.image_url, [400, 800])}
                        sizes="(max-width: 767px) 100vw, (max-width: 1119px) 50vw, 33vw"
                        alt=""
                        loading="lazy"
                        decoding="async"
                      />
                    </span>
                  )
                  : <span class="card-media foto-yok"></span>
                }
                <h3 class="card-title">{n.title}</h3>
                <span class="card-meta">
                  {formatDate(n.published_at) && (
                    <time datetime={isoDate(n.published_at)}>{formatDate(n.published_at)}</time>
                  )}
                </span>
              </a>
            ))}
          </div>

          {toplamSayfa > 1 && (
            <nav class="sayfalama" aria-label="Sayfalar">
              {sayfalar.map(n => (
                n === sayfa
                  ? <span class="sayfa aktif" aria-current="page">{n}</span>
                  : <a class="sayfa" href={`?sayfa=${n}`}>{n}</a>
              ))}
            </nav>
          )}
        </div>
      </section>
    )}

  </main>

  <Footer />
</Layout>

<style>
  /* Öne çıkan kart: görsel solda, başlık sağda, ölçek --fs-lg (§6.1 rolü) */
  .one-cikan {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-3);
    margin-top: var(--sp-5);
  }
  .one-cikan-body {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--sp-2);
  }
  .one-cikan-title {
    font-size: var(--fs-lg);
    font-weight: var(--fw-bold);
    line-height: var(--lh-snug);
    letter-spacing: var(--ls-tight);
    color: var(--text);
    max-width: 24ch;
    text-wrap: balance;
  }
  @media (max-width: 767px) {
    .one-cikan { grid-template-columns: 1fr; }
  }

  .news-section { border-top: 1px solid var(--border); }

  /* Izgara formülü (§2.3) */
  .news-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr));
    gap: var(--sp-3);
  }

  /* ── Sayfalama: yalnız aktif numara yeşil ── */
  .sayfalama { display: flex; gap: var(--sp-2); font-variant-numeric: tabular-nums; }
  .sayfa {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.5rem;
    min-height: 2.5rem;
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    font-size: var(--fs-sm);
    color: var(--text-muted);
    text-decoration: none;
    transition: border-color .15s ease;
  }
  a.sayfa:hover { border-color: var(--border-strong); color: var(--text); }
  a.sayfa:focus-visible { outline: 2px solid var(--green-bright); outline-offset: 2px; }
  .sayfa.aktif { color: var(--green-bright); border-color: var(--border-strong); }
</style>
