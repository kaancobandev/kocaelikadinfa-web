---
import '../../styles/fonts.css';
import '../../styles/admin.css';
import {
  supabase,
  createUserClient,
  type Match,
  type NewsItem,
  type VideoItem,
  type GalleryItem,
  type HeroSettings,
  type AntrenmanGaleriItem,
} from '../../lib/supabase';
import { adminActions } from '../../lib/admin/actions';

import AdminNav from '../../components/admin/AdminNav.astro';
import HeroPanel from '../../components/admin/HeroPanel.astro';
import MatchesPanel from '../../components/admin/MatchesPanel.astro';
import NewsPanel from '../../components/admin/NewsPanel.astro';
import VideoPanel from '../../components/admin/VideoPanel.astro';
import GalleryPanel from '../../components/admin/GalleryPanel.astro';
import ImageField from '../../components/admin/ImageField.astro';

// ── Auth kontrolü ─────────────────────────────────────────────────────
const accessToken = Astro.cookies.get('sb-access-token')?.value;
if (!accessToken) return Astro.redirect('/admin');

const { data: { user } } = await supabase.auth.getUser(accessToken);
if (!user) {
  Astro.cookies.delete('sb-access-token',  { path: '/' });
  Astro.cookies.delete('sb-refresh-token', { path: '/' });
  return Astro.redirect('/admin');
}

// ── POST → işle → yönlendir ───────────────────────────────────────────
// Sonuç query string'e, ilgili panel de hash'e yazılır. Böylece sayfa
// yenilendiğinde form tekrar gönderilmez ve kullanıcı kaydettiği panelde kalır.
if (Astro.request.method === 'POST') {
  const form   = await Astro.request.formData();
  const action = form.get('_action')?.toString() ?? '';

  if (action === 'logout') {
    Astro.cookies.delete('sb-access-token',  { path: '/' });
    Astro.cookies.delete('sb-refresh-token', { path: '/' });
    return Astro.redirect('/admin', 303);
  }

  const handler = adminActions[action];
  if (!handler) return Astro.redirect('/admin/dashboard', 303);

  const result = await handler.run({
    form,
    db: createUserClient(accessToken),
    token: accessToken,
  });

  const params = new URLSearchParams();
  if (result.ok)    params.set('ok',  result.ok.slice(0, 300));
  if (result.error) params.set('err', result.error.slice(0, 300));

  return Astro.redirect(`/admin/dashboard?${params}#${handler.panel}`, 303);
}

const successMsg = Astro.url.searchParams.get('ok')  ?? '';
const errorMsg   = Astro.url.searchParams.get('err') ?? '';

// ── Veriler — hepsi paralel ───────────────────────────────────────────
const [
  matchesRes, newsRes, heroRes, akademiRes,
  pilotHeroRes, pilotRes, aTakimRes, antrenmanRes, videoRes,
] = await Promise.all([
  supabase.from('matches').select('*').order('id', { ascending: false }),
  supabase.from('news').select('*').order('id', { ascending: false }),
  supabase.from('hero_settings').select('*').eq('id', 1).maybeSingle(),
  supabase.from('gallery').select('*').order('sort_order'),
  supabase.from('hero_settings').select('image_url').eq('id', 2).maybeSingle(),
  supabase.from('pilot_gallery').select('*').order('sort_order'),
  supabase.from('a_takim_gallery').select('*').order('sort_order'),
  supabase.from('antrenman_galeri').select('*').order('sort_order'),
  supabase.from('videos').select('*').order('sort_order').limit(3),
]);

const matches:      Match[]               = matchesRes.data   ?? [];
const allArticles:  NewsItem[]            = newsRes.data      ?? [];
const hero:         HeroSettings | null   = heroRes.data      ?? null;
const akademiPhotos: GalleryItem[]        = akademiRes.data   ?? [];
const pilotPhotos:  GalleryItem[]         = pilotRes.data     ?? [];
const aTakimPhotos: GalleryItem[]         = aTakimRes.data    ?? [];
const antrenmanItems: AntrenmanGaleriItem[] = antrenmanRes.data ?? [];
const videos:       VideoItem[]           = videoRes.data     ?? [];
const pilotHeroImage: string | null       = pilotHeroRes.data?.image_url ?? null;

// Maçları kategori (badge) başlığına göre grupla
const matchGroupMap = new Map<string, Match[]>();
for (const m of matches) {
  const key = m.badge || 'Diğer';
  if (!matchGroupMap.has(key)) matchGroupMap.set(key, []);
  matchGroupMap.get(key)!.push(m);
}
const matchGroups: [string, Match[]][] = [...matchGroupMap.entries()];

// Hero'nun sağ panelindeki 4 sabit manşet slotu ve 3 video slotu
const newsSlots  = [1, 2, 3, 4].map(s => allArticles.find(n => n.sort_order === s) ?? null);
const videoSlots = [1, 2, 3].map(s => videos.find(v => v.sort_order === s) ?? null);

// Galeri bileşeni tek bir şekil bekliyor
const asEntries = (rows: GalleryItem[]) =>
  rows.map(r => ({ id: r.id, url: r.image_url, caption: r.caption }));

const antrenmanEntries = antrenmanItems.map(r => ({ id: r.id, url: r.media_url, caption: r.caption }));

const panels = [
  { id: 'hero',      label: 'Ana Sayfa Hero'    },
  { id: 'maclar',    label: 'Maç Sonuçları'     },
  { id: 'haberler',  label: 'Haberler'          },
  { id: 'videolar',  label: 'Videolar'          },
  { id: 'antrenman', label: 'Antrenman Kareleri'},
  { id: 'a-takim',   label: 'A Takım Galerisi'  },
  { id: 'pilot',     label: 'Pilot Takım'       },
  { id: 'akademi',   label: 'Akademi Galerisi'  },
];
---

<!doctype html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard — Kocaeli Kadın FA Admin</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preload" href="/fonts/montserrat-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/montserrat-latin-ext.woff2" as="font" type="font/woff2" crossorigin />


  <!-- JS varsa paneller sekmeye döner; yoksa hepsi alt alta görünür. -->
  <script is:inline>document.documentElement.classList.add('js-tabs');</script>
</head>
<body>

  <header class="topbar">
    <div class="topbar-left">
      <img src="/logo.jpeg" alt="" class="topbar-logo" width="34" height="34" />
      <span class="logo">Kocaeli Kadın FA Admin</span>
    </div>
    <div class="topbar-right">
      <span class="user-email">{user.email}</span>
      <form method="POST" enctype="application/x-www-form-urlencoded">
        <input type="hidden" name="_action" value="logout" />
        <button class="btn-logout">Çıkış</button>
      </form>
      <a href="/" class="btn-site">Siteye Git →</a>
    </div>
  </header>

  <h1 class="sr-only">Kocaeli Kadın FA yönetim paneli</h1>

  <div class="admin-shell">
    <AdminNav panels={panels} />

    <main>
      {successMsg && <div class="alert success" role="status">{successMsg}</div>}
      {errorMsg   && <div class="alert error"   role="alert">{errorMsg}</div>}

      <HeroPanel hero={hero} newsSlots={newsSlots} />

      <MatchesPanel groups={matchGroups} categories={matchGroups.map(([t]) => t)} />

      <NewsPanel articles={allArticles} />

      <VideoPanel videoSlots={videoSlots} />

      <GalleryPanel
        id="antrenman"
        title="Antrenmanlardan Kareler"
        items={antrenmanEntries}
        addAction="antrenman_add"
        deleteAction="antrenman_delete"
        urlName="media_url"
        allowVideo={true}
        addLabel="+ Fotoğraf veya Video Ekle"
        submitLabel="Ekle"
        urlLabel="veya Görsel URL / YouTube Linki"
        urlPlaceholder="https://... veya https://youtube.com/watch?v=..."
        emptyHint="Henüz içerik eklenmemiş. Aşağıdan ilkini ekleyebilirsiniz."
        confirmText="Bu içerik kalıcı olarak silinsin mi?"
      />

      <GalleryPanel
        id="a-takim"
        title="A Takım Galerisi"
        items={asEntries(aTakimPhotos)}
        addAction="a_takim_gallery_add"
        deleteAction="a_takim_gallery_delete"
      />

      <GalleryPanel
        id="pilot"
        title="Pilot Takım"
        items={asEntries(pilotPhotos)}
        addAction="pilot_gallery_add"
        deleteAction="pilot_gallery_delete"
      >
        <form method="POST" enctype="multipart/form-data" class="match-form">
          <input type="hidden" name="_action" value="pilot_hero_save" />
          <p class="slot-label">Sayfa Hero Görseli</p>

          <div class="form-row">
            <ImageField current={pilotHeroImage} urlValue={pilotHeroImage} />
          </div>

          <div class="form-actions">
            <button type="submit" class="btn-save">Kaydet</button>
          </div>
        </form>

        <p class="slot-label" style="margin-top:1.6rem">Galeri</p>
      </GalleryPanel>

      <GalleryPanel
        id="akademi"
        title="Akademi Galerisi"
        items={asEntries(akademiPhotos)}
        addAction="gallery_add"
        deleteAction="gallery_delete"
      />
    </main>
  </div>

  <script is:inline>
    (function () {
      var panels = Array.prototype.slice.call(document.querySelectorAll('.panel[id]'));
      var tabs   = Array.prototype.slice.call(document.querySelectorAll('.admin-tab'));

      // Tek panel görünürken doğru konum her zaman en üst; tarayıcının
      // eski kaydırma konumunu geri yüklemesi mesajı üst çubuğun altında
      // bırakıyordu.
      try { history.scrollRestoration = 'manual'; } catch (e) {}

      // ── Sekmeler ──
      function activate(id) {
        var known  = panels.some(function (p) { return p.id === id; });
        var target = known ? id : (panels[0] && panels[0].id);
        panels.forEach(function (p) { p.classList.toggle('is-active', p.id === target); });
        tabs.forEach(function (t) {
          var on = t.getAttribute('data-panel') === target;
          t.classList.toggle('is-active', on);
          if (on) t.setAttribute('aria-current', 'true');
          else    t.removeAttribute('aria-current');
        });
      }

      // Kaydırmayı CSS hallediyor (.panel { scroll-margin-top }); burada
      // yalnızca hangi panelin görüneceğini belirliyoruz.
      if (panels.length) {
        activate(location.hash.slice(1));
        window.addEventListener('hashchange', function () {
          activate(location.hash.slice(1));
        });
      }

      // ── Dosya seçilince anlık önizleme ──
      document.addEventListener('change', function (e) {
        var input = e.target;
        if (!input.classList || !input.classList.contains('file-input')) return;
        var file    = input.files && input.files[0];
        var preview = input.parentElement && input.parentElement.querySelector('.file-preview');
        if (!preview || !file || file.type.indexOf('image/') !== 0) return;
        preview.src = URL.createObjectURL(file);
        preview.classList.add('is-visible');
      });

      // ── Silme onayı ──
      document.addEventListener('submit', function (e) {
        var form = e.target;
        var msg  = form && form.getAttribute ? form.getAttribute('data-confirm') : null;
        if (msg && !window.confirm(msg)) e.preventDefault();
      });
    })();
  </script>
</body>
</html>
