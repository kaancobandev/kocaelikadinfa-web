---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import { supabase, type AntrenmanGaleriItem } from '../lib/supabase';
import { img, imgSet } from '../lib/img';

const { data } = await supabase
  .from('antrenman_galeri')
  .select('*')
  .order('sort_order', { ascending: true });

const items: AntrenmanGaleriItem[] = data ?? [];

function youtubeId(url: string): string | null {
  const m = url.match(/(?:v=|youtu\.be\/|embed\/|shorts\/)([A-Za-z0-9_-]{11})/);
  return m ? m[1] : null;
}

function isYoutube(url: string): boolean {
  return /youtu(\.be|be\.com)/i.test(url);
}
---

<Layout
  title="Antrenmanlardan Kareler — Kocaeli Kadın Futbol Kulübü"
  description="Kocaeli Kadın Futbol Kulübü antrenmanlarından fotoğraf ve videolar. Sahadaki çalışmalarımıza ve takım ruhumuza yakından bakın."
>
  <Navbar />

  <main id="icerik" tabindex="-1">

    <PageHero
      tag="Videolar & Fotoğraflar"
      title="Galeri"
      description="Sahadan, antrenmandan ve kulübümüzün özel anlarından görüntüler."
      maxTitle="4.5rem"
    />

    <!-- İçerik -->
    {items.length > 0 && (
      <section class="band galeri-section" aria-label="Antrenmanlardan kareler">
        <div class="band-inner">
        <h2>Antrenmanlardan Kareler</h2>
        <div class="galeri-grid">
          {items.map((item, i) => (
            <div class="galeri-card">
              {isYoutube(item.media_url) ? (
                <div class="yt-wrap">
                  <div class="yt-frame-wrap">
                    <iframe
                      src={`https://www.youtube.com/embed/${youtubeId(item.media_url)}`}
                      title={item.caption ?? ''}
                      frameborder="0"
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                      allowfullscreen
                    ></iframe>
                  </div>
                  <span class="card-meta">{item.caption ?? ''}</span>
                </div>
              ) : (
                <button class="img-btn" data-src={img(item.media_url, 1600)} data-caption={item.caption ?? ''} aria-label={item.caption ?? 'Fotoğraf'}>
                  <span class="galeri-media">
                    <img
                      src={img(item.media_url, 800)}
                      srcset={imgSet(item.media_url)}
                      sizes="(max-width: 640px) 100vw, (max-width: 960px) 50vw, 33vw"
                      alt={item.caption ?? ''}
                      {/* İlk satır zaten ekranda; ertelemek yerine hemen insin */}
                      loading={i < 3 ? 'eager' : 'lazy'}
                      fetchpriority={i < 3 ? 'high' : undefined}
                      decoding="async"
                    />
                    <span class="img-overlay">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
                    </span>
                  </span>
                  <span class="card-meta">{item.caption ?? ''}</span>
                </button>
              )}
            </div>
          ))}
        </div>
        </div>
      </section>
    )}

  </main>

  <!-- Lightbox -->
  <div id="lightbox" class="lightbox" role="dialog" aria-modal="true">
    <button id="lb-close" class="lb-close" aria-label="Kapat">✕</button>
    <img id="lb-img" src="" alt="" />
    <p id="lb-caption" class="lb-caption"></p>
  </div>

  <Footer />
</Layout>

<style>
  /* ── Grid ── */
  .galeri-section {
    background: var(--black);
    border-top: 1px solid var(--border);
  }

  /* Izgara — satır satır soldan sağa (§2.3 formülü).
     Önceden kolon bazlı masonry (column-count) kullanılıyordu; orada içerik
     önce 1. kolonu baştan sona doldurup 2. kolona geçtiği için belge sırası
     ekrandaki sırayla örtüşmüyordu. Izgarada sıra soldan sağa aktığı için
     tarayıcı da önce üstü yüklüyor. Satırdaki kartlar eşit yükseklikte. */
  .galeri-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr));
    gap: var(--sp-3);
  }

  .galeri-card {
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--card-bg);
    transition: border-color .15s ease;
  }
  /* Galeri renksiz kalır: hover yalnız kenarlık, yeşil yok */
  .galeri-card:hover { border-color: var(--border-strong); }

  /* YouTube */
  .yt-wrap { display: flex; flex-direction: column; }
  .yt-frame-wrap {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
  }
  .yt-frame-wrap iframe {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    border: none;
  }

  /* Fotoğraf */
  .img-btn {
    position: relative;
    display: block;
    width: 100%;
    border: none;
    background: none;
    cursor: pointer;
    overflow: hidden;
    padding: 0;
  }
  /* Fotoğraf kendi en-boy oranında */
  .galeri-media {
    position: relative;
    display: block;
    overflow: hidden;
  }
  /* Izgarada satırlar hizalı dursun diye ortak oran; yükseklik baştan belli
     olduğu için görsel inerken sayfa da kaymıyor. */
  .img-btn img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    height: auto;
    object-fit: cover;
    object-position: center 40%;
  }

  @media (max-width: 640px) {
    .img-btn img { max-height: var(--media-max-h-sm); }
  }

  .img-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: rgba(0,0,0,0);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background .25s;
  }
  .img-overlay svg {
    width: 44px; height: 44px;
    color: var(--text); opacity: 0;
    transition: opacity .25s;
  }
  .img-btn:hover .img-overlay { background: rgba(0,0,0,.35); }
  .img-btn:hover .img-overlay svg { opacity: 1; }

  /* Altyazı şeridi görselin altında, her zaman görünür */
  .galeri-card .card-meta { padding: var(--sp-2); }

  /* Lightbox */
  .lightbox {
    display: none;
    position: fixed; inset: 0;
    background: rgba(0,0,0,.92);
    z-index: 9000;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 1rem;
    padding: 2rem;
  }
  .lightbox.open { display: flex; }
  .lightbox img {
    max-width: 90vw;
    max-height: 80vh;
    object-fit: contain;
    border-radius: var(--r-md);
    box-shadow: 0 8px 48px rgba(0,0,0,.6);
  }
  .lb-caption {
    color: rgba(255,255,255,.65);
    font-size: var(--fs-sm);
    text-align: center;
    max-width: 640px;
  }
  .lb-close {
    position: fixed;
    top: 1.2rem; right: 1.4rem;
    background: rgba(255,255,255,.1);
    border: 1px solid rgba(255,255,255,.15);
    color: var(--text);
    font-size: var(--fs-md);
    width: 40px; height: 40px;
    border-radius: 50%;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: background .2s;
    z-index: 9100;
  }
  .lb-close:hover { background: rgba(255,255,255,.2); }
</style>

<script>
  const lightbox  = document.getElementById('lightbox')!;
  const lbImg     = document.getElementById('lb-img')      as HTMLImageElement;
  const lbCaption = document.getElementById('lb-caption')!;
  const lbClose   = document.getElementById('lb-close')!;

  document.querySelectorAll<HTMLButtonElement>('.img-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      lbImg.src             = btn.dataset.src ?? '';
      lbImg.alt             = btn.dataset.caption ?? '';
      lbCaption.textContent = btn.dataset.caption ?? '';
      lightbox.classList.add('open');
      document.body.style.overflow = 'hidden';
    });
  });

  function close() {
    lightbox.classList.remove('open');
    document.body.style.overflow = '';
  }
  lbClose.addEventListener('click', close);
  lightbox.addEventListener('click', e => { if (e.target === lightbox) close(); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') close(); });
</script>
