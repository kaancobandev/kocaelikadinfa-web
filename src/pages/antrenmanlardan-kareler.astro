---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import Lightbox from '../components/Lightbox.astro';
import { supabase, type AntrenmanGaleriItem } from '../lib/supabase';
import { img, imgSet } from '../lib/img';

/* ── Sayfalama (§7.2) ───────────────────────────────────────────────────
   Sıralama id'ye göre azalan: sort_order'da aynı değere sahip kayıt yığını
   yapısal (actions.ts çoklu yüklemede 99 + i yazar) ve PostgreSQL eşit
   değerler için kararlı sıra garanti etmez — sort_order ile sayfalansa bir
   fotoğraf iki sayfada çıkar, bir diğeri hiç görünmezdi. id tekil ve
   kronolojik.
   .range() iki ucu da kapsayıcıdır; toplam sayı aynı sorgudan gelir.
   Aralık dışı her değer (0, abc, -5, 9999) 1. sayfaya kırpılır.          */
const SAYFA_BOYU = 24;
const ham = Number(Astro.url.searchParams.get('sayfa'));
const istenen = Number.isFinite(ham) && ham >= 1 ? Math.floor(ham) : 1;

function sayfaGetir(sayfa: number) {
  const bas = (sayfa - 1) * SAYFA_BOYU;
  return supabase
    .from('antrenman_galeri')
    .select('*', { count: 'exact' })
    .order('id', { ascending: false })
    .range(bas, bas + SAYFA_BOYU - 1);
}

const sayfaSayisi = (count: number | null) => Math.max(1, Math.ceil((count ?? 0) / SAYFA_BOYU));

let sayfa = istenen;
let sonuc = await sayfaGetir(sayfa);
let toplamSayfa = sayfaSayisi(sonuc.count);
// Aralık dışı: PostgREST ya boş döner ya 416 (error) — iki durumda da 1. sayfa
if (sonuc.error || sayfa > toplamSayfa) {
  sayfa = 1;
  sonuc = await sayfaGetir(1);
  toplamSayfa = sayfaSayisi(sonuc.count);
}
const items: AntrenmanGaleriItem[] = sonuc.data ?? [];
const sayfalar = Array.from({ length: toplamSayfa }, (_, i) => i + 1);

/* ── Kardeş albümler (§7.5): sayılar sorgudan, elle yazılmaz ─────────── */
const [aTakim, akademi, pilot] = await Promise.all([
  supabase.from('a_takim_gallery').select('*', { count: 'exact', head: true }),
  supabase.from('gallery').select('*', { count: 'exact', head: true }),
  supabase.from('pilot_gallery').select('*', { count: 'exact', head: true }),
]);
const albumler = [
  { ad: 'Antrenmanlardan', sayi: sonuc.count ?? 0,   href: '/antrenmanlardan-kareler', aktif: true },
  { ad: 'A Takım',         sayi: aTakim.count ?? 0,  href: '/a-takim#kareler',         aktif: false },
  { ad: 'Akademi',         sayi: akademi.count ?? 0, href: '/akademi#kareler',         aktif: false },
  { ad: 'Pilot Takım',     sayi: pilot.count ?? 0,   href: '/pilot-takim#kareler',     aktif: false },
].filter(a => a.sayi > 0);

function youtubeId(url: string): string | null {
  const m = url.match(/(?:v=|youtu\.be\/|embed\/|shorts\/)([A-Za-z0-9_-]{11})/);
  return m ? m[1] : null;
}

function isYoutube(url: string): boolean {
  return /youtu(\.be|be\.com)/i.test(url);
}
---

<Layout
  title="Antrenmanlardan Kareler — Kocaeli Kadın Futbol Kulübü"
  description="Kocaeli Kadın Futbol Kulübü antrenmanlarından fotoğraf ve videolar. Sahadaki çalışmalarımıza ve takım ruhumuza yakından bakın."
>
  <Navbar />

  <main id="icerik" tabindex="-1">

    <PageHero
      tag="Videolar & Fotoğraflar"
      title="Galeri"
      description="Sahadan, antrenmandan ve kulübümüzün özel anlarından görüntüler."
      maxTitle="4.5rem"
      compact
    />

    {/* Albüm şeridi: bu sayfa "Galeri" adını taşıyor ama yalnız antrenman
        albümünü gösteriyor. Diğer üç albüm sayfalamanın altındaydı, yani
        86 fotoğraf ve 4 sayfa sonra görünüyordu. Şerit ilk ekranda. */}
    {albumler.length > 1 && (
      <nav class="band albumler-band" aria-label="Albümler">
        <div class="band-inner">
          <ul class="albumler">
            {albumler.map(a => (
              <li>
                {a.aktif
                  ? <span class="album aktif" aria-current="page">{a.ad} <span class="album-sayi">{a.sayi}</span></span>
                  : <a class="album" href={a.href}>{a.ad} <span class="album-sayi">{a.sayi}</span></a>}
              </li>
            ))}
          </ul>
        </div>
      </nav>
    )}

    <!-- Izgara: sayfanın birincil öğesi (lead hücre) ilk ekranda; bölümün
         kendi h2'si yok ki ilk ekranda h1 tek büyük metin kalsın (§4.3).
         Veri yoksa bölüm hiç basılmaz. Yalnız 1. sayfada lead hücre. -->
    {items.length > 0 && (
      <section class="band galeri-section" aria-label="Antrenmanlardan kareler">
        <div class="band-inner">
          <div class={`galeri-grid${sayfa === 1 ? ' lead-var' : ''}`}>
            {items.map((item, i) => (
              isYoutube(item.media_url) ? (
                /* YouTube satırının kendi görseli yok (media_url videonun adresi);
                   dış alan adından poster çekmek yasak — iframe olduğu gibi kalır (§7.6). */
                <div class="card">
                  <span class="card-media">
                    <iframe
                      src={`https://www.youtube.com/embed/${youtubeId(item.media_url)}`}
                      title={item.caption ?? 'Antrenmanlardan kareler'}
                      loading="lazy"
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                      allowfullscreen
                    ></iframe>
                  </span>
                  <span class="card-meta">{item.caption ?? ''}</span>
                </div>
              ) : (
                <button
                  type="button"
                  class="card"
                  data-lb-src={img(item.media_url, 1600)}
                  data-lb-altyazi={item.caption ?? ''}
                >
                  <span class="card-media">
                    <img
                      src={img(item.media_url, 400)}
                      srcset={imgSet(item.media_url, [400, 800])}
                      sizes="(max-width: 767px) 100vw, (max-width: 1119px) 50vw, 33vw"
                      alt={item.caption ?? 'Antrenmanlardan kareler'}
                      {/* İlk satır zaten ekranda; ertelemek yerine hemen insin */}
                      loading={i < 3 ? 'eager' : 'lazy'}
                      fetchpriority={i < 3 ? 'high' : undefined}
                      decoding="async"
                    />
                  </span>
                  {/* Altyazı şeridi her zaman basılır; boşsa yüksekliğini korur */}
                  <span class="card-meta">{item.caption ?? ''}</span>
                </button>
              )
            ))}
          </div>

          <!-- Sayfalama -->
          <div class="galeri-alt">
            {toplamSayfa > 1 && (
              <nav class="sayfalama" aria-label="Sayfalar">
                {sayfalar.map(n => (
                  n === sayfa
                    ? <span class="sayfa aktif" aria-current="page">{n}</span>
                    : <a class="sayfa" href={`?sayfa=${n}`}>{n}</a>
                ))}
              </nav>
            )}
          </div>

          <Lightbox />
        </div>
      </section>
    )}

  </main>

  <Footer />
</Layout>

<style>
  .galeri-section {
    background: var(--black);
    border-top: 1px solid var(--border);
  }

  /* Izgara — satır satır soldan sağa (§2.3 formülü). Kolon bazlı masonry'de
     belge sırası ekrandaki sırayla örtüşmüyordu; ızgarada tarayıcı önce üstü
     yükler. Satırdaki kartlar eşit yükseklikte. */
  .galeri-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr));
    gap: var(--sp-3);
  }
  /* Lead hücre (yalnız 1. sayfa): eşit karo duvarının kontakt baskısı hissini
     kırar, sayfaya tek odak verir (§7.3). Dar ekranda tek kolona düşer. */
  @media (min-width: 768px) {
    .galeri-grid.lead-var > :first-child { grid-column: span 2; grid-row: span 2; }
  }

  /* ── Sayfalama + kardeş albümler ── */
  .galeri-alt {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--sp-3);
  }
  .sayfalama { display: flex; gap: var(--sp-2); font-variant-numeric: tabular-nums; }
  .sayfa {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.5rem;
    min-height: 2.5rem;
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    font-size: var(--fs-sm);
    color: var(--text-muted);
    text-decoration: none;
    transition: border-color .15s ease;
  }
  a.sayfa:hover { border-color: var(--border-strong); color: var(--text); }
  a.sayfa:focus-visible { outline: 2px solid var(--green-bright); outline-offset: 2px; }
  /* Yeşil yalnız aktif sayfa numarasında (§5.11) */
  .sayfa.aktif { color: var(--green-bright); border-color: var(--border-strong); }

  /* Albüm şeridi: sekme değil, ince bir çizgi üstünde soluk metinler.
     Aktif albüm yeşil; sayılar sorgudan gelir, elle yazılmaz. */
  .albumler-band { padding-block: 0; }
  .albumler {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-4);
    border-bottom: 1px solid var(--border);
    padding-bottom: var(--sp-2);
  }
  .album {
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    color: var(--text-muted);
    text-decoration: none;
    transition: color .2s;
  }
  a.album:hover { color: var(--text); }
  a.album:focus-visible { outline: 2px solid var(--green-bright); outline-offset: 3px; }
  .album.aktif { color: var(--green-bright); }
  .album-sayi { font-variant-numeric: tabular-nums; color: var(--text-dim); }
</style>
