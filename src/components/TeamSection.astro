---
const stats = [
  { deger: '2016',  etiket: 'Kuruluş' },
  { deger: '1. Lig', etiket: 'A Takım' },
  { deger: '4–16',  etiket: 'Akademi Yaş' },
];
---

<section class="band team-section" id="a-takim">
  <div class="band-inner team-inner">

    <div class="team-text">
      <span class="eyebrow">Takımlar</span>
      <!-- Ziyaretçi tıklamadan önce ve sonra aynı adı görür: /a-takim h1'i ile birebir -->
      <h2>A Takım — Kadınlar 1. Ligi</h2>
      <p>
        A takımımız, bölgenin en köklü kadın futbol ekiplerinden biri olma yolunda emin
        adımlarla ilerliyor. Kadınlar 1. Lig'in tamamen kendi altyapısından beslenen
        kadrosuyla sahadayız.
      </p>
      <!-- Üçüncül bağlantı: takım keşfi (§4.4). Maç sonuçları bağlantısı Scores'ta zaten var. -->
      <a href="/a-takim" class="link-tertiary">A Takımı Tanı →</a>
    </div>

    <div class="team-visual">
      <img src="/a-takim-hero.jpeg" alt="Kocaeli Kadın FK A Takım" loading="lazy" decoding="async" />
      <div class="team-stats">
        {stats.map(s => (
          <div class="stat">
            <span class="stat-num">{s.deger}</span>
            <span class="stat-lbl">{s.etiket}</span>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<style>
  .team-section {
    background: var(--black);
    border-top: 1px solid var(--border);
  }

  /* İki kolon: metin solda, görsel sağda */
  .team-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-5);
    align-items: center;
  }
  .team-inner > * + * { margin-top: 0; }
  @media (max-width: 767px) {
    .team-inner { grid-template-columns: 1fr; gap: var(--sp-4); }
  }

  .team-text h2 { margin-bottom: var(--sp-3); }
  .team-text p  { margin-bottom: var(--sp-4); }

  .link-tertiary {
    display: inline-block;
    font-size: var(--fs-sm);
    color: var(--text-muted);
    text-decoration: none;
    transition: color .2s;
  }
  .link-tertiary:hover { color: var(--text); }
  .link-tertiary:focus-visible { outline: 2px solid var(--green-bright); outline-offset: 3px; }

  /* Görsel + künye */
  .team-visual {
    border-radius: var(--r-md);
    overflow: hidden;
    border: 1px solid var(--border);
    width: 100%;
  }
  .team-visual img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    max-height: var(--media-max-h);
    object-fit: cover;
    object-position: center 35%;
  }

  .team-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    background: var(--surface);
    border-top: 1px solid var(--border);
  }
  .stat {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-1);
    padding: var(--sp-2) var(--sp-3);
  }
  .stat + .stat { border-left: 1px solid var(--border); }
  .stat-num {
    font-size: var(--fs-md);
    font-weight: var(--fw-bold);
    color: var(--text);
    line-height: var(--lh-tight);
    font-variant-numeric: tabular-nums;
  }
  .stat-lbl {
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-medium);
    line-height: 1;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--text-muted);
  }
</style>
