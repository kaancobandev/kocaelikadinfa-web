---
import { supabase, type Match } from '../lib/supabase';
import { img } from '../lib/img';
import { shortTeamName } from '../lib/news';

// Tüm maçları çek, her kategoriden (badge) en son eklenen maçı göster
const { data } = await supabase
  .from('matches')
  .select('*')
  .order('id', { ascending: false });

const allMatches: Match[] = data ?? [];

const seen = new Set<string>();
const latestMatches: Match[] = [];
for (const m of allMatches) {
  const key = m.badge || 'Diğer';
  if (!seen.has(key)) {
    seen.add(key);
    latestMatches.push(m);
  }
}

function initials(name: string) {
  return name.split(' ').map(w => w[0]).slice(0, 2).join('').toUpperCase();
}

const TR_MONTHS = ['Ocak','Şubat','Mart','Nisan','Mayıs','Haziran','Temmuz','Ağustos','Eylül','Ekim','Kasım','Aralık'];
function formatDate(d: string) {
  const m = d.match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if (!m) return d;
  return `${parseInt(m[3])} ${TR_MONTHS[parseInt(m[2]) - 1]} ${m[1]}`;
}
---

{latestMatches.length > 0 && (
  <section class="band scores-section">
    <div class="band-inner">
      <h2>Son Maç Sonuçları</h2>

      <div class="scores-grid">
        {latestMatches.map(m => (
          <div class="score-card">
            <span class="score-badge">{m.badge}</span>
            <div class="match-row">

              <div class="team home">
                <div class="team-logo-wrap">
                  {m.home_logo
                    ? <img src={img(m.home_logo, 120)} alt={m.home_name} class="team-logo" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
                    : null
                  }
                  <span class="team-logo-fallback" style={m.home_logo ? "display:none" : "display:flex"}>
                    {initials(m.home_name)}
                  </span>
                </div>
                <span class="team-name">
                  <span class="tn-full">{m.home_name}</span>
                  <span class="tn-short">{shortTeamName(m.home_name)}</span>
                </span>
              </div>

              <div class="score-box">
                <span class="score-num">{m.score_home}</span>
                <span class="score-sep">–</span>
                <span class="score-num">{m.score_away}</span>
              </div>

              <div class="team away">
                <div class="team-logo-wrap">
                  {m.away_logo
                    ? <img src={img(m.away_logo, 120)} alt={m.away_name} class="team-logo" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
                    : null
                  }
                  <span class="team-logo-fallback" style={m.away_logo ? "display:none" : "display:flex"}>
                    {initials(m.away_name)}
                  </span>
                </div>
                <span class="team-name">
                  <span class="tn-full">{m.away_name}</span>
                  <span class="tn-short">{shortTeamName(m.away_name)}</span>
                </span>
              </div>

            </div>
            <div class="match-meta">
              {formatDate(m.match_date)}
              {m.league?.trim() && <span class="meta-sep">|</span>}
              {m.league?.trim()}
            </div>
          </div>
        ))}
      </div>

      {/* Ana sayfadan /mac-gecmisi'ye başka hiçbir yol yoktu; tek ikincil bağlantı */}
      <a href="/mac-gecmisi" class="scores-tumu">Tüm sonuçlar →</a>
    </div>
  </section>
)}

<style>
  .scores-section {
    background: var(--black);
    border-top: 1px solid var(--border);
  }

  /* Bölüm ortalı. auto-fill yerine auto-fit: auto-fill 1120px'e üç kolon
     açıyor, iki maç varken üçüncü kolon BOŞ KALIYOR ama yer kaplamaya
     devam ediyordu — kartlar solda, sağda kocaman boşluk. auto-fit boş
     kolonu çökertiyor, böylece justify-content ortalayacak boşluk buluyor.
     1fr yerine 360px tavanı: 1fr kartları gerip tüm genişliğe yayardı,
     ortalanacak boşluk yine kalmazdı. */
  .scores-section .band-inner { text-align: center; }
  .scores-grid {
    display: grid;
    /* KORUNDU: min() olmadan kolon tabanı 320px'de sabitleniyor; 320px'lik
       ekranda dolgudan sonra 288px yer kaldığı için kart taşıyor ve
       sayfa yatay kayıyordu. min(320px, 100%) tabanı dar ekranda kaldırıyor. */
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 360px));
    justify-content: center;
    gap: var(--sp-3);
  }
  /* Kart içi olduğu gibi kalır: skor satırı ve takım adları sola hizalı */
  .score-card { text-align: left; }

  .score-card {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    padding: var(--sp-3);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    transition: border-color .15s ease;
  }
  .score-card:hover { border-color: var(--border-strong); }

  /* Kategori adı küçük etiket: kart başına yeşil zemin yok */
  .score-badge {
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-medium);
    line-height: 1;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* Ev · skor · deplasman — hepsi sola hizalı, ortalanmış metin yok */
  .match-row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--sp-2);
  }

  .team {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-1);
    min-width: 0;
  }

  .team-logo-wrap {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--black);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .team-logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: calc(var(--sp-2) / 2);
  }
  .team-logo-fallback {
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-medium);
    color: var(--text-muted);
    letter-spacing: var(--ls-eyebrow);
    align-items: center;
    justify-content: center;
  }

  .team-name {
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    line-height: var(--lh-snug);
    color: var(--text);
  }
  /* Dar ekranda kısa ad — "Kocaeli Kadın Futbol Kulübü" 4 satıra bölünmesin */
  .tn-short { display: none; }
  @media (max-width: 767px) {
    .tn-full  { display: none; }
    .tn-short { display: inline; }
  }

  .score-box {
    display: flex;
    align-items: center;
    gap: var(--sp-1);
    flex-shrink: 0;
  }
  .score-num { font-variant-numeric: tabular-nums;
    font-size: 2.4rem;
    font-weight: 900;   /* bilinçli istisna: 900 yalnızca skorlarda */
    color: var(--green-bright);
    line-height: 1;
  }
  .score-sep { font-size: 1.6rem; color: var(--text-muted); font-weight: var(--fw-normal); }

  .match-meta {
    font-size: var(--fs-sm);
    line-height: var(--lh-snug);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  /* Lig adı boşken ayraç da basılmıyor */
  .meta-sep { margin: 0 var(--sp-1); }

  .db-error {
    color: var(--kirmizi);
    font-size: var(--fs-sm);
  }

  /* İkincil biçim: metin bağlantı + ok */
  .scores-tumu {
    display: inline-block;
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    color: var(--green-bright);
    text-decoration: none;
    transition: color .2s;
  }
  .scores-tumu:hover { color: var(--text); }
  .scores-tumu:focus-visible { outline: 2px solid var(--green-bright); outline-offset: 3px; border-radius: var(--r-sm); }
</style>
