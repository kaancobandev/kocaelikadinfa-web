---
import { supabase, type AntrenmanGaleriItem } from '../lib/supabase';
import { img, imgSet } from '../lib/img';
import Lightbox from './Lightbox.astro';

// /antrenmanlardan-kareler ile aynı sıralama (id, azalan): ziyaretçi
// "Tümünü Gör"e basınca bu üç kareyi listenin başında bulur (§7.1).
const { data } = await supabase
  .from('antrenman_galeri')
  .select('*')
  .order('id', { ascending: false })
  .limit(3);

const items: AntrenmanGaleriItem[] = data ?? [];

function youtubeId(url: string): string | null {
  const m = url.match(/(?:v=|youtu\.be\/|embed\/|shorts\/)([A-Za-z0-9_-]{11})/);
  return m ? m[1] : null;
}

function isYoutube(url: string): boolean {
  return /youtu(\.be|be\.com)/i.test(url);
}
---

{items.length > 0 && (
  <section class="band video-section" id="videolar" aria-label="Antrenmanlardan kareler">
    <div class="band-inner">
      <span class="eyebrow">Videolar & Fotoğraflar</span>
      <h2>Antrenmanlardan Kareler</h2>

      <div class="video-grid">
        {items.map(item => (
          isYoutube(item.media_url) ? (
            /* YouTube satırının kendi görseli yok; dış alan adından poster
               çekmek yasak — iframe olduğu gibi kalır (§7.6). */
            <div class="card">
              <span class="card-media">
                <iframe
                  src={`https://www.youtube.com/embed/${youtubeId(item.media_url)}`}
                  title={item.caption ?? 'Antrenmanlardan kareler'}
                  loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                ></iframe>
              </span>
              <span class="card-meta">{item.caption ?? ''}</span>
            </div>
          ) : (
            <button
              type="button"
              class="card"
              data-lb-src={img(item.media_url, 1600)}
              data-lb-altyazi={item.caption ?? ''}
            >
              <span class="card-media">
                <img
                  src={img(item.media_url, 400)}
                  srcset={imgSet(item.media_url, [400, 800])}
                  sizes="(max-width: 767px) 100vw, (max-width: 1119px) 50vw, 33vw"
                  alt={item.caption ?? 'Antrenmanlardan kareler'}
                  loading="lazy"
                  decoding="async"
                />
              </span>
              {/* Altyazı şeridi her zaman basılır; boşsa yüksekliğini korur */}
              <span class="card-meta">{item.caption ?? ''}</span>
            </button>
          )
        ))}
      </div>

      <!-- Tek üçüncül bağlantı: galeri keşfi (§4.4) -->
      <a href="/antrenmanlardan-kareler" class="btn-all">Tümünü Gör →</a>

      <Lightbox />
    </div>
  </section>
)}

<style>
  .video-section {
    background: var(--black);
    border-top: 1px solid var(--border);
  }

  /* Izgara formülü (§2.3): 3'ten az öğede kartlar sola yığılır */
  .video-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(min(280px, 100%), 1fr));
    gap: var(--sp-3);
  }
  @media (max-width: 1119px) { .video-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 767px)  { .video-grid { grid-template-columns: 1fr; } }

  /* Üçüncül biçim: soluk metin bağlantı */
  .btn-all {
    display: inline-block;
    font-size: var(--fs-sm);
    color: var(--text-muted);
    text-decoration: none;
    transition: color .2s;
  }
  .btn-all:hover { color: var(--text); }
  .btn-all:focus-visible { outline: 2px solid var(--green-bright); outline-offset: 3px; }
</style>
