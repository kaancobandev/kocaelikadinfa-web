---
/**
 * Ana sayfa hero'su — sitenin tek --fs-display başlığı.
 *
 * h1 artık haber manşeti değil, kulübün adı; altında tek satır künye.
 * hero_settings.title ölmedi: hemen altındaki h2 manşetini besler ve en
 * yeni habere bağlanır — panelin başlık alanı çalışmaya devam eder.
 * hero_settings.badge manşetin eyebrow'udur. "Diğer Manşetler" cam paneli
 * kalktı; kompozisyon ≥1120px'de 7/5: solda metin, sağda tek tam
 * yükseklik fotoğraf (§2.3). <768px'de fotoğraf üstte 4/3, metin altta.
 */
import { supabase, type HeroSettings, type NewsItem } from '../lib/supabase';
import { img, imgSet } from '../lib/img';
import { newsPath } from '../lib/news';

interface Props {
  /** En yeni haber — manşet bağlantısının hedefi (index.astro'daki tek sorgudan) */
  enYeni?: NewsItem;
}
const { enYeni } = Astro.props;

const { data } = await supabase
  .from('hero_settings')
  .select('*')
  .eq('id', 1)
  .maybeSingle();

const hero: HeroSettings = data ?? {
  id: 1,
  badge: '',
  title: '',
  description: '',
  image_url: '/hero_section.jpeg',
};

// Manşet: panelden girilen başlık; boşsa en yeni haberin kendi başlığı.
// Habersiz sitede manşet hiç basılmaz (yer tutucu yok).
const manset = (hero.title?.trim() || enYeni?.title || '').trim();
const mansetHref = enYeni ? newsPath(enYeni) : '';

// Hero görseli sayfanın LCP'si. CSS background olarak dururken tarayıcı onu
// ancak stil işlendikten sonra keşfedebiliyordu; gerçek <img> olarak preload
// tarayıcısı HTML'i okur okumaz indirmeye başlar. srcset sayesinde telefon
// 1600px yerine kendi genişliğine uygun dosyayı çeker.
const heroSrc    = hero.image_url || '/hero_section.jpeg';
const heroImg    = img(heroSrc, 1600, 70) || heroSrc;
const heroSrcSet = imgSet(heroSrc, [640, 1024, 1600, 2000], 70);
---

<section class="hero-wrap" aria-label="Kulüp tanıtımı">
  <div class="hero-text">
    <h1>Kocaeli Kadın Futbol Kulübü</h1>
    <p class="hero-alt">Kadınlar 1. Ligi, Kadınlar 3. Ligi ve 4-16 yaş akademisi.</p>

    <a href="/aramiza-katil" class="btn-primary">Akademi Ön Kaydı</a>

    {manset && mansetHref && (
      <div class="hero-manset">
        {hero.badge?.trim() && <span class="eyebrow">{hero.badge}</span>}
        <h2><a href={mansetHref}>{manset} →</a></h2>
      </div>
    )}
  </div>

  <img
    class="hero-foto"
    src={heroImg}
    srcset={heroSrcSet}
    sizes="(max-width: 767px) 100vw, 42vw"
    alt=""
    fetchpriority="high"
    decoding="async"
  />
</section>

<style>
  .hero-wrap {
    display: grid;
    grid-template-columns: 7fr 5fr;
    min-height: calc(100vh - var(--nav-h));
    background: var(--black);
  }

  /* Birincil öğe: üst/alt boşluk komşu bölümlerin (--sp-6) iki katı */
  .hero-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: calc(var(--sp-6) * 2) var(--gutter);
  }

  .hero-text h1 {
    font-size: var(--fs-display);
    font-weight: var(--fw-bold);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-display);
    max-width: 18ch;
  }
  .hero-alt {
    font-size: var(--fs-md);
    line-height: var(--lh-snug);
    color: var(--text-body);
    margin-top: var(--sp-3);
  }
  .hero-text .btn-primary { margin-top: var(--sp-4); }

  /* Manşet: ikinci en büyük metin en çok --fs-md (§2.1.1) */
  .hero-manset {
    margin-top: calc(var(--sp-6) * 1);
    padding-top: var(--sp-3);
    border-top: 1px solid var(--border);
    max-width: var(--measure-text);
  }
  .hero-manset h2 {
    font-size: var(--fs-md);
    line-height: var(--lh-snug);
    letter-spacing: normal;
    max-width: 30ch;
  }
  /* İkincil biçim: metin bağlantı + ok */
  .hero-manset a {
    color: var(--green-bright);
    text-decoration: none;
    transition: color .2s;
  }
  .hero-manset a:hover { color: var(--text); }
  .hero-manset a:focus-visible { outline: 2px solid var(--green-bright); outline-offset: 3px; }

  .hero-foto {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
  }

  @media (max-width: 767px) {
    .hero-wrap { grid-template-columns: 1fr; min-height: 0; }
    .hero-foto { order: -1; aspect-ratio: 4 / 3; height: auto; }
    .hero-text { padding: calc(var(--sp-5) * 2) var(--gutter); }
  }
</style>
