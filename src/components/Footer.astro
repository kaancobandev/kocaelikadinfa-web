<style>
  /* Dolgu global .band'den (--sp-6 / --sp-5), iç genişlik .band-inner'dan.
     Alt barı footer'ın tam genişliğinde çizmek için footer'ın alt dolgusu 0. */
  .footer {
    background: var(--black);
    border-top: 1px solid var(--border);
    padding-bottom: 0;
  }

  /* İçerik ızgarası: dört kolon → iki → bir (§2.3 kırılma noktaları) */
  .footer-inner {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.1fr;
    gap: var(--sp-4);
    padding-bottom: var(--sp-6);
  }
  .footer-inner > * + * { margin-top: 0; }

  @media (max-width: 1119px) {
    .footer-inner { grid-template-columns: 1fr 1fr; }
    .footer-brand { grid-column: 1 / -1; }
  }
  @media (max-width: 767px) {
    .footer-inner { grid-template-columns: 1fr; padding-bottom: var(--sp-5); }
  }

  /* ── Brand ── */
  .footer-logo {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    text-decoration: none;
    margin-bottom: var(--sp-3);
    width: fit-content;
  }
  /* Düz yeşil halka: degrade yok */
  .footer-logo-img {
    width: 52px; height: 52px;
    flex-shrink: 0;
    object-fit: contain;
    border-radius: 50%;
    border: 2px solid var(--green);
    background: var(--black);
  }

  .footer-logo-texts { display: flex; flex-direction: column; }
  .footer-logo-name {
    font-size: var(--fs-md);
    font-weight: var(--fw-bold);
    color: var(--text);
    line-height: var(--lh-tight);
  }
  .footer-logo-sub {
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-medium);
    line-height: 1;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--text-muted);
    margin-top: var(--sp-1);
  }

  .footer-desc {
    font-size: var(--fs-sm);
    color: var(--text-body);
    line-height: var(--lh-body);
    max-width: 280px;
    margin-bottom: var(--sp-4);
  }

  .social-links {
    display: flex;
    gap: var(--sp-1);
  }
  .social-btn {
    width: 40px; height: 40px;
    border-radius: var(--r-md);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    text-decoration: none;
    transition: border-color .15s ease, color .15s ease;
  }
  .social-btn:hover {
    border-color: var(--border-strong);
    color: var(--text);
  }
  .social-btn:focus-visible { outline: 2px solid var(--green-bright); outline-offset: 2px; }

  /* ── Kolon ── */
  .footer-col h4 {
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-medium);
    line-height: 1;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: var(--sp-3);
    padding-bottom: var(--sp-2);
    border-bottom: 1px solid var(--border);
  }

  .footer-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
  }

  .footer-col ul a {
    display: inline-block;
    text-decoration: none;
    color: var(--text-muted);
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    transition: color .2s;
  }
  .footer-col ul a:hover { color: var(--text); }

  /* ── Reklam & İş Birliği ── */
  .collab-desc {
    font-size: var(--fs-sm);
    color: var(--text-body);
    line-height: var(--lh-body);
    margin-bottom: var(--sp-3);
  }

  .collab-phone {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    color: var(--green-bright);
    text-decoration: none;
    font-variant-numeric: tabular-nums;
    transition: color .2s;
  }
  .collab-phone:hover { color: var(--text); }

  /* ── İletişim ── */
  /* .footer-col ul (0,3,0) ile aynı özgüllük, sonra geldiği için kazanır: önem bayrağı gerekmez */
  .footer-col .contact-list {
    margin-bottom: var(--sp-3);
    gap: var(--sp-2);
  }

  .contact-list li {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    color: var(--text-muted);
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
  }
  /* E-posta mailto: bağlantısı; satırdaki düz metinle aynı görünür */
  .contact-list a {
    color: inherit;
    text-decoration: none;
    transition: color .2s;
  }
  .contact-list a:hover { color: var(--text); }

  .contact-icon {
    width: 28px; height: 28px;
    border-radius: var(--r-md);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--text-muted);
  }

  /* İkincil biçim: zeminsiz, çerçevesiz metin bağlantı */
  .footer-cta {
    display: inline-block;
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    color: var(--green-bright);
    text-decoration: none;
    transition: color .2s;
  }
  .footer-cta:hover { color: var(--text); }
  .footer-cta:focus-visible { outline: 2px solid var(--green-bright); outline-offset: 3px; }

  /* ── Alt bar: footer'ın tam genişliğinde ince çizgi ── */
  .footer-bottom {
    border-top: 1px solid var(--border);
    margin-inline: calc(-1 * var(--gutter));
    padding-inline: var(--gutter);
  }
  .footer-bottom-inner {
    padding-block: var(--sp-3);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-2);
    flex-wrap: wrap;
  }

  .copy {
    font-size: var(--fs-sm);
    color: var(--text-dim);
    max-width: none;
  }

  /* ── Dokunmatik cihazlarda basılabilir alan ───────────────────────────
     Linkler geniş ama inceydi: menü bağlantıları 22px yükseklikte ve
     aralarında yalnızca 9px boşlukla duruyordu, parmakla yanlış linke
     basmak kolaydı. Dolgu ekleniyor — yazının konumu değişmiyor, yalnızca
     dokunulabilir alan ~44px'e çıkıyor. Fareyle kullanılan ekranlarda bu
     kural hiç çalışmaz. */
  @media (pointer: coarse) {
    .footer-col ul { gap: 0; }
    .footer-col ul a { padding: var(--sp-2) 0; }
    .collab-phone { padding: var(--sp-1) 0; }
  }
</style>
