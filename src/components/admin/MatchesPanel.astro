---
import Panel from './Panel.astro';
import type { Match } from '../../lib/supabase';

interface Props {
  /** Maçlar kategori (badge) başlığına göre gruplanmış hâlde gelir. */
  groups: [string, Match[]][];
  /** Yeni maç formundaki kategori önerileri. */
  categories: string[];
}

const { groups, categories } = Astro.props;
---

<Panel id="maclar" title="Maç Sonuçları">
  {groups.length > 0 ? (
    groups.map(([title, list]) => (
      <div class="match-subsection">
        <p class="subsection-label">{title}</p>

        <div class="article-list">
          {list.map(m => (
            <div class="article-block">
              <div class="article-row">
                <div class="article-meta">
                  <span class="article-title">
                    {m.home_name} {m.score_home} – {m.score_away} {m.away_name}
                  </span>
                  <span class="article-desc">
                    {m.match_date}{m.league?.trim() ? ` · ${m.league}` : ''}
                  </span>
                </div>
                <form
                  method="POST"
                  enctype="application/x-www-form-urlencoded"
                  class="article-delete-form"
                  data-confirm={`"${m.home_name} – ${m.away_name}" maçı silinsin mi?`}
                >
                  <input type="hidden" name="_action" value="delete" />
                  <input type="hidden" name="id" value={m.id} />
                  <button type="submit" class="btn-delete btn-delete-small">Sil</button>
                </form>
              </div>

              <details class="article-edit">
                <summary>Düzenle</summary>
                <form method="POST" enctype="multipart/form-data" class="match-form flush">
                  <input type="hidden" name="_action" value="update" />
                  <input type="hidden" name="id" value={m.id} />

                  <div class="form-row">
                    <label>Kategori / Başlık
                      <input name="badge" value={m.badge} required />
                    </label>
                    <label>Tarih
                      <input type="date" name="match_date" value={m.match_date} required />
                    </label>
                    <label>Lig (isteğe bağlı)
                      <input name="league" value={m.league ?? ''} placeholder="örn. 1. Lig" />
                    </label>
                  </div>

                  <div class="form-row teams-row">
                    <div class="team-block">
                      <span class="team-label">Ev Sahibi</span>
                      <label>Takım Adı
                        <input name="home_name" value={m.home_name} required />
                      </label>
                      <label>Logo — Cihazdan Yükle
                        <div class="file-wrap">
                          {m.home_logo && <img src={m.home_logo} class="news-preview" alt="Ev sahibi logosu" />}
                          <img class="news-preview file-preview" alt="Seçilen dosyanın önizlemesi" />
                          <input type="file" name="home_logo_file" accept="image/*" class="file-input" />
                        </div>
                      </label>
                      <label>veya URL
                        <input name="home_logo_url" value={m.home_logo ?? ''} placeholder="https://..." />
                      </label>
                    </div>

                    <div class="score-block">
                      <label>Skor
                        <div class="score-inputs">
                          <input type="number" name="score_home" value={m.score_home} min="0" required />
                          <span>–</span>
                          <input type="number" name="score_away" value={m.score_away} min="0" required />
                        </div>
                      </label>
                    </div>

                    <div class="team-block">
                      <span class="team-label">Deplasman</span>
                      <label>Takım Adı
                        <input name="away_name" value={m.away_name} required />
                      </label>
                      <label>Logo — Cihazdan Yükle
                        <div class="file-wrap">
                          {m.away_logo && <img src={m.away_logo} class="news-preview" alt="Deplasman logosu" />}
                          <img class="news-preview file-preview" alt="Seçilen dosyanın önizlemesi" />
                          <input type="file" name="away_logo_file" accept="image/*" class="file-input" />
                        </div>
                      </label>
                      <label>veya URL
                        <input name="away_logo_url" value={m.away_logo ?? ''} placeholder="https://..." />
                      </label>
                    </div>
                  </div>

                  <div class="form-actions">
                    <button type="submit" class="btn-save">Kaydet</button>
                  </div>
                </form>
              </details>
            </div>
          ))}
        </div>
      </div>
    ))
  ) : (
    <p class="empty-hint">Henüz maç eklenmemiş. Aşağıdan ilk maçı ekleyebilirsiniz.</p>
  )}

  <form method="POST" enctype="multipart/form-data" class="match-form new-match spaced">
    <input type="hidden" name="_action" value="match_add" />
    <input type="hidden" name="sort_order" value="99" />
    <p class="slot-label">+ Yeni Maç Ekle</p>

    <div class="form-row">
      <label>Kategori / Başlık
        <input name="badge" list="badge-options" placeholder="örn. U13, U15, 1.Lig" required />
        <datalist id="badge-options">
          {categories.map(c => <option value={c} />)}
        </datalist>
      </label>
      <label>Tarih
        <input type="date" name="match_date" required />
      </label>
      <label>Lig (isteğe bağlı)
        <input name="league" placeholder="örn. 1. Lig" />
      </label>
    </div>

    <div class="form-row teams-row">
      <div class="team-block">
        <span class="team-label">Ev Sahibi</span>
        <label>Takım Adı
          <input name="home_name" placeholder="KKFK" required />
        </label>
        <label>Logo — Cihazdan Yükle
          <div class="file-wrap">
            <img class="news-preview file-preview" alt="Seçilen dosyanın önizlemesi" />
            <input type="file" name="home_logo_file" accept="image/*" class="file-input" />
          </div>
        </label>
        <label>veya URL
          <input name="home_logo_url" placeholder="https://..." />
        </label>
      </div>

      <div class="score-block">
        <label>Skor
          <div class="score-inputs">
            <input type="number" name="score_home" value="0" min="0" required />
            <span>–</span>
            <input type="number" name="score_away" value="0" min="0" required />
          </div>
        </label>
      </div>

      <div class="team-block">
        <span class="team-label">Deplasman</span>
        <label>Takım Adı
          <input name="away_name" placeholder="Rakip FK" required />
        </label>
        <label>Logo — Cihazdan Yükle
          <div class="file-wrap">
            <img class="news-preview file-preview" alt="Seçilen dosyanın önizlemesi" />
            <input type="file" name="away_logo_file" accept="image/*" class="file-input" />
          </div>
        </label>
        <label>veya URL
          <input name="away_logo_url" placeholder="https://..." />
        </label>
      </div>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn-save">Maç Ekle</button>
    </div>
  </form>
</Panel>
