---
/**
 * Sayfa başlığı bloğu — iç sayfaların tek h1'i.
 *
 * Eskiden 7 sayfada birebir kopyalanan ızgara deseni + degrade + yeşil
 * ikinci satır burada toplanmıştı; degrade, doku ve yeşil vurgu gitti.
 * Fotoğraflı varyantta görsel artık metnin ARKASINDA değil ALTINDA durur:
 * tam iç genişlik, üstüne hiçbir metin binmez, karartma gerekmez (§2.2.1,
 * §2.2.5). Blok sayfanın birincil öğesidir: üst/alt boşluğu komşu
 * bölümlerin iki katıdır (§4.3).
 */
interface Props {
  /** Üstteki küçük etiket — birim ya da zaman, h1'i tekrar etmez */
  tag?: string;
  /** Başlık */
  title: string;
  /** Başlığın devamı (aynı renk, aynı satırda sarılır) */
  accent?: string;
  /** Başlık altındaki tek giriş paragrafı */
  description?: string;
  /** Başlığın altında tam genişlik basılan fotoğraf (img() çıktısı) */
  image?: string;
  /** Fotoğrafın srcset'i (imgSet() çıktısı) */
  imageSet?: string;
  /** Fotoğrafın ALTINDAKİ tek satır künye (§2.2.5). Yalnız fotoğraf varsa
      basılır; boşsa hiç basılmaz, boş satır bırakmaz. */
  caption?: string;
  /** Başlık boyutu için clamp üst sınırı */
  maxTitle?: string;
  /**
   * Kısa hero: birincil öğe başlık değil hemen altındaki içerik olan sayfada
   * (yalnız /antrenmanlardan-kareler, lead hücre ilk ekranda görünmeli).
   * Diğer sayfalarda hero geniş ekranda ilk ekranı tek başına kaplar:
   * h1 ekrandaki tek --fs-display/--fs-xl metin olur (§2.1.1, §4.3).
   */
  compact?: boolean;
}

const {
  tag,
  title,
  accent,
  description,
  image,
  imageSet,
  caption,
  maxTitle = '5.5rem',
  compact = false,
} = Astro.props;
---

<section class:list={['page-hero', 'band', { compact }]} style={`--ph-max-title:${maxTitle};`}>
  <div class="band-inner">
    {tag && <span class="eyebrow">{tag}</span>}
    <h1>{accent ? `${title} ${accent}` : title}</h1>
    {description && <p>{description}</p>}
    <slot />
    {image && (
      <img
        class="ph-image"
        src={image}
        srcset={imageSet}
        sizes="(max-width: 1120px) 100vw, 1120px"
        alt=""
        fetchpriority="high"
        decoding="async"
      />
    )}
    {image && caption && <p class="ph-altyazi">{caption}</p>}
  </div>
</section>

<style>
  /* Fotoğraf künyesi: görselin hemen altında, overlay değil (§2.2.5) */
  .ph-altyazi {
    margin-top: var(--sp-2);
    font-size: var(--fs-sm);
    line-height: var(--lh-body);
    color: var(--text-muted);
    max-width: var(--measure-text);
  }

  /* Birincil öğe: üst/alt boşluk komşu bölümlerin (--sp-6) iki katı */
  .page-hero { padding-block: calc(var(--sp-6) * 2); }
  @media (max-width: 767px) {
    .page-hero { padding-block: calc(var(--sp-5) * 2); }
  }
  /* Geniş ekranda hero ilk ekranı tek başına kaplar: bir sonraki bölümün
     h2'si ilk ekrana girmez, h1 yalnız kalır. Dikkat çerçeveyle değil
     yalnızlıkla çekilir (§2.1.2); boş görünüyorsa doğrudur. */
  @media (min-width: 768px) {
    .page-hero:not(.compact) {
      min-height: calc(100vh - var(--nav-h));
      display: flex;
      align-items: center;
    }
    .page-hero:not(.compact) > .band-inner { width: 100%; }
  }

  .page-hero h1 {
    /* font-size tokenlanmadı: --ph-max-title prop'u sayfa başına başlık
       boyutunu ayarlıyor (7 sayfa), token sabit üst sınır getirirdi. */
    font-size: clamp(2.4rem, 7vw, var(--ph-max-title));
    font-weight: var(--fw-bold);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-display);
    max-width: 20ch;
  }

  /* Fotoğraf: geniş kadraj, kırpma odağı üstte (yüzler üst yarıda) */
  .ph-image {
    display: block;
    width: 100%;
    aspect-ratio: 21 / 9;
    max-height: var(--media-max-h);
    object-fit: cover;
    object-position: center 35%;
    border-radius: var(--r-md);
    margin-top: var(--sp-5);
  }
  @media (max-width: 768px) {
    .ph-image { aspect-ratio: 4 / 3; max-height: var(--media-max-h-sm); }
  }
</style>
