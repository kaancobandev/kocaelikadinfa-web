---
/**
 * Sayfa başlığı bloğu.
 *
 * Bu blok (ızgara deseni + degrade + vurgulu başlık) daha önce 7 sayfada
 * birebir kopyalanmıştı. Tek yerde toplandı; sayfalar yalnızca farklılıkları
 * prop olarak veriyor.
 */
interface Props {
  /** Üstteki küçük etiket — ör. "Son Dakika" */
  tag?: string;
  /** Başlığın ilk satırı */
  title: string;
  /** Başlığın yeşil degradeli ikinci satırı */
  accent?: string;
  /** Başlık altındaki açıklama */
  description?: string;
  /** Bölüm yüksekliği — ör. "38vh" */
  minHeight?: string;
  /** Arka plan fotoğrafı (CSS url değeri hazır gelmeli) */
  image?: string;
  /** Metin hizası */
  align?: 'left' | 'right';
  /** Başlık boyutu için clamp üst sınırı */
  maxTitle?: string;
}

const {
  tag,
  title,
  accent,
  description,
  minHeight = '40vh',
  image,
  align = 'left',
  maxTitle = '5.5rem',
} = Astro.props;
---

<section
  class:list={['page-hero', { 'has-image': !!image, right: align === 'right' }]}
  style={`--ph-min:${minHeight};--ph-max-title:${maxTitle};${image ? `--ph-image:url('${image}');` : ''}`}
>
  <div class="page-hero-inner">
    {tag && <span class="ph-tag">{tag}</span>}
    <h1>
      {title}{accent && <><br /><span>{accent}</span></>}
    </h1>
    {description && <p class="ph-desc">{description}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    min-height: var(--ph-min);
    display: flex;
    align-items: center;
    padding: 5rem 8%;
    position: relative;
    overflow: hidden;
    background: var(--black);
  }

  /* Fotoğraflı varyant: görsel en altta, üstünde düz karartma (degrade yok) */
  .page-hero.has-image {
    background: var(--ph-image) center / cover no-repeat;
  }
  .page-hero.has-image::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: var(--scrim);
  }

  .page-hero-inner {
    position: relative;
    max-width: 680px;
  }
  .page-hero.right .page-hero-inner { margin-left: auto; text-align: right; }
  .page-hero.right .ph-desc { margin-left: auto; }

  .ph-tag {
    display: inline-block;
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--green-bright);
    margin-bottom: 1rem;
  }

  .page-hero h1 {
    /* font-size tokenlanmadı: --ph-max-title prop'u sayfa başına başlık
       boyutunu ayarlıyor (7 sayfa), token sabit üst sınır getirirdi. */
    font-size: clamp(2.4rem, 7vw, var(--ph-max-title));
    font-weight: var(--fw-bold);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-display);
    margin-bottom: 1.2rem;
  }
  /* İkinci satır artık yeşil değil: --green-bright başlık ölçeğinde kullanılmaz */

  .ph-desc {
    font-size: var(--fs-base);
    color: var(--text-body);
    max-width: 460px;
    line-height: var(--lh-body);
  }

  @media (max-width: 640px) {
    .page-hero { padding: 4rem 6%; }
  }
</style>
