---
/**
 * Menü — 5 düğüm + 1 buton. Aynı liste dört yüzeyde elle tutuluyor:
 * Navbar, Footer "Keşfet", 404.astro ve sitemap.xml.ts; biri değişirse
 * dördü birlikte değişir.
 *
 * "Sonuçlar" ve "Galeri" etiketleri adreslerinden farklı: /mac-gecmisi ve
 * /antrenmanlardan-kareler dizine girmiş adreslerdir, bu turda bilerek
 * değiştirilmedi. "Takımlar" ise /takimlar giriş sayfasına gider; iki takım
 * orada eşit ağırlıkta durur, detay sayfaları (/a-takim, /pilot-takim)
 * olduğu gibi kalır.
 */
const links = [
  { href: "/takimlar",                label: "Takımlar" },
  { href: "/akademi",                 label: "Akademi" },
  { href: "/mac-gecmisi",             label: "Sonuçlar" },
  { href: "/haberler",                label: "Haberler" },
  { href: "/antrenmanlardan-kareler", label: "Galeri" },
];

/* Tek odak kuralı (§4.2): <main> içinde dolgulu birincil buton olan üç
   sayfada navbar butonu dolgulu değil ÇERÇEVELİ basılır; böylece bir
   ekranda aynı hedefe giden iki dolgulu yeşil buton bulunmaz. */
const dolguluSayfalar = ['/', '/akademi', '/aramiza-katil'];
const yol = Astro.url.pathname.replace(/\/+$/, '') || '/';
const cerceveli = dolguluSayfalar.includes(yol);

/* Alt navigasyon (<1160px) dört düğüm taşır; beşinci düğüm "Sonuçlar"
   üst şeritte kalır, çünkü çubuğun ortasındaki yükseltilmiş daire
   "Aramıza Katıl"a ait. İkinci bir liste TUTULMUYOR: dörtleme kuralı
   (Navbar/Footer/404/sitemap) bozulmasın diye kaynak yine yukarıdaki
   links dizisi, buradan yalnızca süzülüyor. */
const UST_SERIT = '/mac-gecmisi';
const altLinkler = links.filter(l => l.href !== UST_SERIT);
const ustLink    = links.find(l => l.href === UST_SERIT);

/* İkonlar satır içi SVG — yeni bağımlılık yok. 24x24, currentColor. */
const ikonlar: Record<string, string> = {
  '/a-takim': '<circle cx="9" cy="8" r="3.2"/><path d="M2.5 20c0-3.4 2.9-5.8 6.5-5.8s6.5 2.4 6.5 5.8"/><path d="M16.5 5.6a3.2 3.2 0 0 1 0 6"/><path d="M21.5 20c0-2.5-1.3-4.3-3.3-5.2"/>',
  '/akademi': '<path d="M12 4 2.5 8.6 12 13.2l9.5-4.6L12 4Z"/><path d="M6.5 10.6V15c0 1.8 2.5 3 5.5 3s5.5-1.2 5.5-3v-4.4"/>',
  '/haberler': '<rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M7 9.5h6M7 13h10M7 16h6"/>',
  '/antrenmanlardan-kareler': '<rect x="3" y="5" width="18" height="14" rx="2.5"/><circle cx="8.5" cy="10" r="1.6"/><path d="m4.5 17.5 4.5-4.5 3.5 3.5 3-2.5 4 4"/>',
};
---

<nav class="navbar" id="navbar">
  <a class="nav-logo" href="/">
    <img src="/logo.jpeg" alt="Kocaeli Kadın FA Logo" class="logo-img" />
    <span class="logo-text">Kocaeli Kadın Futbol Kulübü</span>
  </a>

  {/* Dar ekranda menü alt çubuğa taşındı; beşinci düğüm burada kalıyor */}
  {ustLink && (
    <a
      class="ust-serit-link"
      href={ustLink.href}
      aria-current={yol === ustLink.href ? 'page' : undefined}
    >{ustLink.label}</a>
  )}

  <ul class="nav-links" id="nav-links">
    {links.map(l => (
      <li><a href={l.href}>{l.label}</a></li>
    ))}
    <li>
      <a href="/aramiza-katil" class:list={['btn-join', { 'btn-join--cerceveli': cerceveli }]}>Aramıza Katıl</a>
    </li>
  </ul>
</nav>

{/* ── Alt navigasyon (<1160px) ──────────────────────────────────────
    Hamburger'ın yerini alır: beş yüzeyin dördü burada, beşincisi üst
    şeritte; hiçbiri saklı değil. Ortadaki yükseltilmiş daire bir sekme
    DEĞİL, CTA — bu yüzden asla "aktif" durumuna girmez. Aktif sekmeyi
    KAPSÜL, CTA'yı DAİRE gösteriyor: ikisi de koyu yeşil, ayrımı şekil
    yapıyor (renk değil), çünkü ikisi aynı renkte. */}
<nav class="alt-nav" aria-label="Alt menü">
  <ul class="alt-nav-liste">
    {altLinkler.slice(0, 2).map(l => (
      <li>
        <a
          href={l.href}
          class:list={['alt-nav-oge', { aktif: yol === l.href }]}
          aria-current={yol === l.href ? 'page' : undefined}
        >
          <span class="alt-nav-kapsul">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <Fragment set:html={ikonlar[l.href] ?? ''} />
            </svg>
          </span>
          <span class="alt-nav-etiket">{l.label}</span>
        </a>
      </li>
    ))}

    <li class="alt-nav-cta-yuva">
      <a href="/aramiza-katil" class="alt-nav-cta" aria-label="Aramıza Katıl">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
          <path d="M12 6v12M6 12h12" />
        </svg>
      </a>
    </li>

    {altLinkler.slice(2).map(l => (
      <li>
        <a
          href={l.href}
          class:list={['alt-nav-oge', { aktif: yol === l.href }]}
          aria-current={yol === l.href ? 'page' : undefined}
        >
          <span class="alt-nav-kapsul">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <Fragment set:html={ikonlar[l.href] ?? ''} />
            </svg>
          </span>
          <span class="alt-nav-etiket">{l.label}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .navbar {
    position: sticky;
    top: 0; left: 0; right: 0;
    height: var(--nav-h);
    background: var(--black);
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 5%;
    z-index: 1000;
    transition: height .3s, transform .3s ease;
  }
  .navbar.scrolled { height: 58px; }


  .nav-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }
  .logo-img { height: 42px; width: 42px; object-fit: contain; border-radius: 50%; }

  @media (max-width: 1160px) {
    .nav-logo { padding: 8px 0; }
    .logo-img { height: 38px; width: 38px; }
  }
  .logo-text {
    font-size: var(--fs-base);
    font-weight: var(--fw-bold);
    letter-spacing: .02em;
    color: var(--text);
  }


  .nav-links {
    display: flex;
    align-items: center;
    list-style: none;
    gap: 2rem;
  }
  /* Uppercase yalnız --fs-eyebrow ölçeğinde (§6.1.2); menü --fs-sm'dir */
  .nav-links a {
    text-decoration: none;
    color: var(--text-muted);
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    transition: color .25s;
  }
  .nav-links a:hover { color: var(--green-bright); }

  /* ── Aramıza Katıl ──────────────────────────────────────────────────
     Sitenin en önemli tek butonu sonsuz dönen beyaz bir ışıkla sarılıydı.
     O görsel dil indirme butonu / reklam bandı dilidir; potansiyel sporcu
     ailesine güven vermesi gereken buton en ucuz görünen öğe oluyordu.
     Konumu ve rengi zaten yeterli. */
  .nav-links .btn-join {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: .55rem 1.25rem;
    background: var(--green);
    color: var(--text);
    font-weight: var(--fw-bold);
    border: 1px solid var(--border-strong);
    border-radius: var(--r-pill);
    transition: background .2s;
  }
  /* :hover'da da beyaz kalsın — .nav-links a:hover (0,5,0) yeşile çeviriyordu,
     eskiden !important ile bastırılıyordu. */
  .nav-links .btn-join:hover { background: var(--green-mid); color: var(--text); }
  /* Çerçeveli varyant: zemin yok, 1px yeşil çerçeve, yeşil metin */
  .nav-links .btn-join--cerceveli {
    background: transparent;
    border-color: var(--green-bright);
    color: var(--green-bright);
  }
  .nav-links .btn-join--cerceveli:hover { background: transparent; color: var(--text); }
  /* KORUNDU: silinirse sitenin birincil CTA'sı klavye odağını kaybeder */
  .nav-links .btn-join:focus-visible { outline: 2px solid var(--green-bright); outline-offset: 2px; }

  /* ── Dar masaüstü / büyük tablet ────────────────────────────────────
     Kulübün tam adı (1.4rem + 3px harf aralığı) tek başına 384px yer
     kaplıyordu; 6 link ve butonla birlikte tek satır için ~1280px
     gerekiyordu (ölçüm: 1473px). Altında kalan genişliklerde logo üç satıra bölünüp
     navbar'ın dışına taşıyordu. Bu bantta yazıyı ve boşlukları
     sıkıştırıyoruz (ölçülen ihtiyaç: 1473px → 1155px); bunun da altında
     hamburger menü devralıyor. */
  @media (max-width: 1500px) {
    .logo-text { font-size: 1rem; letter-spacing: .5px; }
    .nav-links { gap: 1.2rem; }
    .nav-links a { font-size: .8rem; letter-spacing: .5px; }
    /* Taban kural .nav-links .btn-join (0,4,0); medya sorgusu özgüllük
       eklemediği için tek sınıflı .btn-join (0,2,0) onu ezemiyordu. */
    .nav-links .btn-join { padding: .5rem 1rem; }
  }

  @media (max-width: 1160px) {
    /* Tam ad iki satıra düzgün sarılsın (navbar yüksekliğine sığar) */
    .logo-text {
      font-size: .82rem;
      letter-spacing: .5px;
      line-height: 1.15;
      max-width: 180px;
    }

    /* Menü alt çubuğa taşındı; üstte logo + beşinci düğüm kalıyor */
    .nav-links { display: none; }

    /* Üst şerit aşağı kaydırınca gizlenir; alt çubuk HİÇ gizlenmez —
       menünün sürekli görünür olması bu işin asıl sebebi. */
    .navbar.ust-gizli { transform: translateY(-100%); }
    /* İçerik çubuğun altında kalmasın */
    :global(body) { padding-bottom: calc(104px + env(safe-area-inset-bottom, 0px)); }
  }
  /* ── Üst şeritteki beşinci düğüm (yalnız dar ekran) ── */
  .ust-serit-link {
    display: inline-flex;
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    letter-spacing: .5px;
    color: var(--text);
    text-decoration: none;
    padding: .45rem .9rem;
    min-height: 44px;
    align-items: center;
    border: 1px solid var(--border-strong);
    border-radius: var(--r-pill);
  }
  .ust-serit-link[aria-current='page'] {
    color: var(--green-bright);
    border-color: var(--green-bright);
  }
  .ust-serit-link:focus-visible { outline: 2px solid var(--green-bright); outline-offset: 3px; }

  /* ── Alt navigasyon ───────────────────────────────────────────────
     Yüzen hap çubuk. Zemin --kemik (açık): sayfanın geri kalanı koyu
     olduğu için açık yüzey, navigasyonun içerikten ayrı bir KATMAN
     olduğunu söylüyor ve arkasında hangi fotoğraf olursa olsun okunur
     kalıyor. Koyu yeşil kapsülün görünmesi de buna bağlı: --green,
     --kemik üstünde 8,9:1; koyu bir çubuk zemininde 1,8:1 olurdu,
     yani kapsül fark edilmezdi. */
  .alt-nav {
    display: block;
    position: fixed;
    left: 0; right: 0;
    bottom: calc(var(--sp-2) + env(safe-area-inset-bottom, 0px));
    z-index: 1000;
    padding-inline: var(--sp-3);
    pointer-events: none;   /* yalnız çubuğun kendisi tıklanabilir */
  }
  .alt-nav-liste {
    pointer-events: auto;
    list-style: none;
    margin: 0 auto;
    padding: .35rem .5rem;
    max-width: 440px;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    align-items: center;
    background: var(--kemik);
    border-radius: var(--r-pill);
    box-shadow: 0 10px 30px rgba(0,0,0,.45);
  }

  .alt-nav-oge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    padding-block: 5px;
    min-height: 44px;
    justify-content: center;
    text-decoration: none;
    color: var(--alt-nav-pasif);
    border-radius: var(--r-pill);
  }
  .alt-nav-kapsul {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px; height: 28px;
    border-radius: var(--r-pill);
    transition: background-color .25s ease, color .25s ease;
  }
  .alt-nav-kapsul svg { width: 19px; height: 19px; }
  .alt-nav-etiket {
    font-size: .66rem;
    line-height: 1;
    white-space: nowrap;
  }
  .alt-nav-oge.aktif { color: var(--surface); }
  .alt-nav-oge.aktif .alt-nav-kapsul { background: var(--green); color: var(--text); }
  .alt-nav-oge.aktif .alt-nav-etiket { font-weight: var(--fw-bold); }
  .alt-nav-oge:focus-visible { outline: 2px solid var(--green); outline-offset: 2px; }

  /* CTA bir sekme değil: daire, çubuktan yukarı taşıyor ve hiç hareket
     etmiyor. Aktif kapsülle aynı renkte olduğu için ayrımı şekil yapıyor. */
  .alt-nav-cta-yuva { display: flex; justify-content: center; }
  .alt-nav-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 54px; height: 54px;
    margin-top: -24px;
    border-radius: 50%;
    background: var(--green);
    color: var(--text);
    border: 3px solid var(--kemik);
    box-shadow: 0 8px 18px rgba(0,0,0,.4);
  }
  .alt-nav-cta svg { width: 22px; height: 22px; }
  .alt-nav-cta:focus-visible { outline: 2px solid var(--green-bright); outline-offset: 3px; }

  /* Masaüstünde alt çubuk yok; üstteki navbar devralıyor. Bu kural
     taban .alt-nav kuralından SONRA gelmek zorunda: ikisi de 0,2,0
     özgüllükte, kazananı sıra belirliyor. */
  @media (min-width: 1161px) {
    .alt-nav { display: none; }
    .ust-serit-link { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .alt-nav-kapsul, .navbar { transition: none; }
  }
</style>

<script>
  const navbar = document.getElementById('navbar');

  // iOS Safari sticky fix: boş touchstart ile dokunma olayları etkinleşir
  navbar?.addEventListener('touchstart', () => {}, { passive: true });

  // Scroll → üst şeridi küçült, aşağı kaydırırken gizle.
  // Alt çubuk bu mantığın DIŞINDA: hiçbir koşulda gizlenmiyor, çünkü
  // menünün sürekli görünür olması hamburger'ı kaldırma sebebimizdi.
  let sonY = window.scrollY;
  window.addEventListener('scroll', () => {
    const y = window.scrollY;
    navbar?.classList.toggle('scrolled', y > 60);

    // Sayfa başında şerit hep görünür
    if (y <= 120) { navbar?.classList.remove('ust-gizli'); sonY = y; return; }

    // Eşikler BİLEREK asimetrik. Aşırı kaydırma geri tepmesi ölçüldü:
    // tek hamlede 803e çıkıp 797ye yaslanıyor. Simetrik eşikte o 6px
    // "yukarı kaydırma" sayılıp şeridi anında geri getiriyordu. Gizleme
    // küçük harekete, geri getirme BİLİNÇLİ bir yukarı kaydırmaya bağlı.
    const fark = y - sonY;
    if (fark > 8) {
      navbar?.classList.add('ust-gizli');
      sonY = y;
    } else if (fark < -40) {
      navbar?.classList.remove('ust-gizli');
      sonY = y;
    }
    // Aradaki küçük oynamalarda sonY GÜNCELLENMEZ; yoksa geri tepme
    // birikerek eşiği aşardı.
  }, { passive: true });

  // Dokunulan sekmenin kapsülü hemen yerine geçsin. Sayfa yüklenene
  // kadar geri bildirim verir ama gezinmeyi geciktirmez (preventDefault yok).
  document.querySelectorAll<HTMLElement>('.alt-nav-oge').forEach(oge => {
    oge.addEventListener('click', () => {
      document.querySelectorAll('.alt-nav-oge.aktif')
        .forEach(eski => eski.classList.remove('aktif'));
      oge.classList.add('aktif');
    });
  });
</script>
