---
const links = [
  { href: "/pilot-takim", label: "Pilot Takım" },
  { href: "/mac-gecmisi", label: "Maç Geçmişi" },
  { href: "/a-takim",     label: "A Takım" },
  { href: "/akademi",     label: "Akademi" },
  { href: "/haberler",              label: "Haberler" },
  { href: "/antrenmanlardan-kareler", label: "Galeri" },
];
---

<nav class="navbar" id="navbar">
  <a class="nav-logo" href="/">
    <img src="/logo.jpeg" alt="Kocaeli Kadın FA Logo" class="logo-img" />
    <span class="logo-text">Kocaeli Kadın Futbol Kulübü</span>
  </a>

  <button
    type="button"
    id="nav-toggle"
    class="nav-burger"
    aria-label="Menüyü aç"
    aria-expanded="false"
    aria-controls="nav-links"
  >
    <span></span><span></span><span></span>
  </button>

  <ul class="nav-links" id="nav-links">
    {links.map(l => (
      <li><a href={l.href}>{l.label}</a></li>
    ))}
    <li>
      <a href="/aramiza-katil" class="btn-join">Aramıza Katıl</a>
    </li>
  </ul>
</nav>

<style>
  .navbar {
    position: sticky;
    top: 0; left: 0; right: 0;
    height: var(--nav-h);
    background: rgba(0,0,0,0.93);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 5%;
    z-index: 1000;
    transition: height .3s;
  }
  .navbar.scrolled { height: 58px; }

  /* Mobil menü açıkken arkadaki sayfa kaymasın. Sınıf <html> üzerinde
     olduğu için :global gerekiyor (IntroLoader da aynı yöntemi kullanıyor). */
  :global(html.nav-locked),
  :global(html.nav-locked body) { overflow: hidden; }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }
  .logo-img { height: 42px; width: 42px; object-fit: contain; border-radius: 50%; }

  @media (max-width: 1160px) {
    .nav-logo { padding: 8px 0; }
    .logo-img { height: 38px; width: 38px; }
  }
  .logo-text {
    font-size: var(--fs-base);
    font-weight: var(--fw-bold);
    letter-spacing: .02em;
    color: var(--text);
  }

  .nav-burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    cursor: pointer;
    /* Gerçek buton: klavyeyle odaklanabilir ve Enter/Space ile açılır */
    background: none;
    border: none;
    /* Parmakla basılan tek kontrol; 37x36 idi, dokunma hedefi sınırının
       altındaydı. Çizgilerin görünümü aynı, yalnızca kutu büyüyor. */
    min-width: 44px;
    min-height: 44px;
    padding: 0;
    margin-right: -9px;
    border-radius: var(--r-sm);
  }
  .nav-burger span {
    display: block;
    width: 25px; height: 2px;
    background: var(--text);
    border-radius: var(--r-sm);
    transition: .3s;
  }
  .nav-burger:focus-visible {
    outline: 2px solid var(--green-bright);
    outline-offset: 2px;
  }

  .nav-links {
    display: flex;
    align-items: center;
    list-style: none;
    gap: 2rem;
  }
  .nav-links a {
    text-decoration: none;
    color: var(--text-muted);
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    transition: color .25s;
  }
  .nav-links a:hover { color: var(--green-bright); }

  /* ── Aramıza Katıl ──────────────────────────────────────────────────
     Sitenin en önemli tek butonu sonsuz dönen beyaz bir ışıkla sarılıydı.
     O görsel dil indirme butonu / reklam bandı dilidir; potansiyel sporcu
     ailesine güven vermesi gereken buton en ucuz görünen öğe oluyordu.
     Konumu ve rengi zaten yeterli. */
  .nav-links .btn-join {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: .55rem 1.25rem;
    background: var(--green);
    color: #fff !important;
    font-weight: var(--fw-bold);
    border: 1px solid var(--border-strong);
    border-radius: var(--r-pill);
    transition: background .2s;
  }
  .nav-links .btn-join:hover { background: var(--green-mid); }
  /* KORUNDU: silinirse sitenin birincil CTA'sı klavye odağını kaybeder */
  .nav-links .btn-join:focus-visible { outline: 2px solid var(--green-bright); outline-offset: 2px; }

  /* ── Dar masaüstü / büyük tablet ────────────────────────────────────
     Kulübün tam adı (1.4rem + 3px harf aralığı) tek başına 384px yer
     kaplıyordu; 6 link ve butonla birlikte tek satır için ~1280px
     gerekiyordu (ölçüm: 1473px). Altında kalan genişliklerde logo üç satıra bölünüp
     navbar'ın dışına taşıyordu. Bu bantta yazıyı ve boşlukları
     sıkıştırıyoruz (ölçülen ihtiyaç: 1473px → 1155px); bunun da altında
     hamburger menü devralıyor. */
  @media (max-width: 1500px) {
    .logo-text { font-size: 1rem; letter-spacing: .5px; }
    .nav-links { gap: 1.2rem; }
    .nav-links a { font-size: .8rem; letter-spacing: .5px; }
    .btn-join { padding: .5rem 1rem; }
  }

  @media (max-width: 1160px) {
    /* Tam ad iki satıra düzgün sarılsın (navbar yüksekliğine sığar) */
    .logo-text {
      font-size: .82rem;
      letter-spacing: .5px;
      line-height: 1.15;
      max-width: 180px;
    }

    .nav-burger { display: flex; }

    .nav-links {
      position: fixed;
      top: var(--nav-h); left: 0; right: 0;
      background: rgba(6,8,6,0.98);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      flex-direction: column;
      gap: 0;
      padding: 0.5rem 0 2rem;
      transform: translateY(-110%);
      opacity: 0;
      /* Kapalıyken klavyeyle içine sekme yapılamasın.
         visibility kapanışta animasyon bitince, açılışta ise anında değişsin. */
      visibility: hidden;
      transition: transform .35s ease, opacity .3s ease, visibility 0s linear .35s;
      border-bottom: 1px solid var(--border);
      z-index: 999;
    }
    .navbar.nav-open .nav-links {
      visibility: visible;
      transition: transform .35s ease, opacity .3s ease, visibility 0s;
    }
    .nav-links li { width: 100%; text-align: center; }
    .nav-links a {
      display: block;
      padding: 1rem 0;
      font-size: var(--fs-base);
      border-bottom: 1px solid rgba(255,255,255,0.04);
    }
    .nav-links li:last-child a { border-bottom: none; }

    .navbar.nav-open .nav-links {
      transform: translateY(0);
      opacity: 1;
    }

    /* Burger → X animasyonu */
    .nav-burger[aria-expanded='true'] span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }
    .nav-burger[aria-expanded='true'] span:nth-child(2) {
      opacity: 0;
      transform: scaleX(0);
    }
    .nav-burger[aria-expanded='true'] span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
  }
</style>

<script>
  const navbar = document.getElementById('navbar');
  const toggle = document.getElementById('nav-toggle') as HTMLButtonElement | null;

  // iOS Safari sticky fix: boş touchstart ile dokunma olayları etkinleşir
  navbar?.addEventListener('touchstart', () => {}, { passive: true });

  // Scroll → küçült
  window.addEventListener('scroll', () => {
    navbar?.classList.toggle('scrolled', window.scrollY > 60);
  });

  const navLinks = document.getElementById('nav-links');

  const isOpen = () => toggle?.getAttribute('aria-expanded') === 'true';

  /** Menü açıkken Tab'ın dolaşabileceği öğeler — hamburger butonu dahil,
   *  böylece Shift+Tab ile butona dönüp menüyü kapatmak mümkün. */
  const odaklanabilirler = (): HTMLElement[] => [
    ...(toggle ? [toggle] : []),
    ...Array.from(navLinks?.querySelectorAll<HTMLElement>('a[href]') ?? []),
  ];

  function setMenu(open: boolean) {
    const odakMenüdeydi = !!navLinks?.contains(document.activeElement);

    navbar?.classList.toggle('nav-open', open);
    // Menü açıkken arkadaki sayfa kaymasın
    document.documentElement.classList.toggle('nav-locked', open);
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Menüyü kapat' : 'Menüyü aç');

    if (open) {
      // Odağı menünün içine al; aksi hâlde Tab, menünün arkasındaki
      // görünmeyen bağlantılar arasında dolaşıyordu.
      odaklanabilirler()[1]?.focus();
    } else if (odakMenüdeydi) {
      // Menü kapanırken odak görünmez bir öğede kalmasın
      toggle?.focus();
    }
  }

  toggle?.addEventListener('click', () => setMenu(!isOpen()));

  document.addEventListener('keydown', e => {
    if (!isOpen()) return;

    if (e.key === 'Escape') {
      setMenu(false);
      toggle?.focus();
      return;
    }

    // Odak tuzağı: Tab menünün dışına çıkmasın, başa/sona sarsın
    if (e.key === 'Tab') {
      const öğeler = odaklanabilirler();
      if (!öğeler.length) return;
      const ilk = öğeler[0];
      const son = öğeler[öğeler.length - 1];

      if (e.shiftKey && document.activeElement === ilk) {
        e.preventDefault();
        son.focus();
      } else if (!e.shiftKey && document.activeElement === son) {
        e.preventDefault();
        ilk.focus();
      }
    }
  });

  // Ekran hamburger eşiğinin üstüne büyürse menü kapansın; aksi hâlde
  // görünmeyen bir menü yüzünden sayfa kilitli kalıyor.
  const genişEkran = window.matchMedia('(min-width: 1161px)');
  genişEkran.addEventListener('change', e => {
    if (e.matches && isOpen()) setMenu(false);
  });

  // Menü dışına tıklayınca kapat
  document.addEventListener('click', e => {
    if (!isOpen()) return;
    if (!navbar?.contains(e.target as Node)) setMenu(false);
  });

  // Mobil: linke tıklayınca menüyü kapat (logo dahil)
  document.querySelectorAll('.nav-links a, .nav-logo').forEach(link => {
    link.addEventListener('click', () => setMenu(false));
  });
</script>
