---
// Siteye giriş animasyonu — "Yıldız Akışı" (Higgsfield plate videosu).
// Kaynak: kkfk-yildiz-akisi-higgsfield.html
//
// Yıldızlar 4 köşeden armaya akar (Higgsfield'de üretilmiş video plate,
// mix-blend-mode:screen ile siyah zemin şeffaflaşır), arma dokunulmamış
// orijinal olarak plate'in ÜSTÜNDE durur. Video yüklenmezse arkadaki
// yeşil ışık devralır.
//
// Altyapı davranışı: oturum başına BİR kez oynar; reduced-motion'da
// atlanır; overlay'den önce çalışan pre-paint script flash'ı önler.
// Video ve arma yalnızca animasyon oynayacaksa indirilir (atlanırsa
// 2.8MB'lık video hiç istenmez).
//
// Varlıklar: public/intro/kkfk-plate.mp4, public/intro/arma.webp
---

<script is:inline>
  // Pre-paint: overlay boyanmadan önce skip/play kararı.
  (function () {
    var root = document.documentElement, skip = false;
    try {
      if (sessionStorage.getItem('kkfa-intro-seen') === '1') skip = true;
      else sessionStorage.setItem('kkfa-intro-seen', '1');
    } catch (e) { /* gizli sekme vb. → her açılışta oynasın */ }
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) skip = true;
    root.classList.add(skip ? 'kkfk-skip' : 'kkfk-playing');
  })();
</script>

<div id="kkfk-intro" role="presentation" aria-hidden="true">
  <div class="yedek-isik"></div>

  <!-- Higgsfield plate — src JS ile atanır (atlanınca indirilmesin) -->
  <video class="plate" muted playsinline preload="auto"></video>

  <!-- Dokunulmamış arma — src JS ile atanır -->
  <div class="arma"><img alt="" decoding="async" /></div>

  <button class="gec" type="button">Geç</button>
</div>

<noscript>
  <style>#kkfk-intro { display: none !important; }</style>
</noscript>

<style>
  :root {
    --kkfk-siyah:      #050705;
    --kkfk-cim:        #2fa757;
    --kkfk-cim-parlak: #62e58c;
    --kkfk-arma-cap:   min(46vh, 78vw, 460px);
  }

  /* Görüldüyse / reduced-motion → hiç boyanmasın (flash yok) */
  :global(html.kkfk-skip) #kkfk-intro { display: none !important; }
  /* Oynarken sayfa kaymasın */
  :global(html.kkfk-playing),
  :global(html.kkfk-playing body) { overflow: hidden; }

  /* ---------- PERDE ---------- */
  #kkfk-intro {
    position: fixed; inset: 0; z-index: 9999;
    display: grid; place-items: center; overflow: hidden;
    background: var(--kkfk-siyah);
    transition: opacity .85s cubic-bezier(.4,0,.2,1), transform .85s cubic-bezier(.4,0,.2,1);
  }
  #kkfk-intro.bitti { opacity: 0; transform: scale(1.07); pointer-events: none; }
  #kkfk-intro.kapali { display: none; }

  /* ---------- PLATE (Higgsfield videosu) ---------- */
  .plate {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; pointer-events: none;
    /* siyah zemini şeffaflaştırır: banding ve kutu kenarı görünmez */
    mix-blend-mode: screen;
    /* Video hazır olduğu an oynatmayla birlikte açılır. Açılma kısa
       tutuldu: uzun fade, yıldızların aktığı ilk saniyeyi yutuyordu. */
    opacity: 0;
    transition: opacity .45s ease-out;
    will-change: opacity;
  }
  #kkfk-intro.plate-hazir .plate { opacity: 1; }

  /* Video yüklenmezse arkada yine yeşil ışık kalsın */
  .yedek-isik {
    position: absolute; left: 50%; top: 50%;
    width: min(92vh, 150vw); aspect-ratio: 1 / 1;
    transform: translate(-50%, -50%);
    border-radius: 50%; pointer-events: none; z-index: 0;
    background: radial-gradient(circle,
      rgba(98,229,140,.20) 0%, rgba(47,167,87,.10) 34%, transparent 66%);
    /* blur(14px) kaldırıldı: gradyan zaten yumuşak, görsel fark yok ama
       tam ekran filtre her karede yeniden rasterize ediliyordu. */
    will-change: transform, opacity;
    animation: kkfk-nefes 4.2s ease-in-out infinite;
  }
  @keyframes kkfk-nefes {
    0%, 100% { transform: translate(-50%, -50%) scale(1);    opacity: .75; }
    50%      { transform: translate(-50%, -50%) scale(1.07); opacity: 1; }
  }

  /* ---------- ARMA (dokunulmamış orijinal) ---------- */
  .arma {
    position: relative; z-index: 2;
    width: var(--kkfk-arma-cap); aspect-ratio: 1 / 1;
    opacity: 0; animation: kkfk-armaGir 1.15s .15s cubic-bezier(.2,.7,.25,1) forwards;
  }
  @keyframes kkfk-armaGir {
    from { opacity: 0; transform: scale(.9); }
    to   { opacity: 1; transform: none; }
  }
  .arma img {
    width: 100%; height: 100%; display: block; user-select: none;
    filter: drop-shadow(0 0 30px rgba(47,167,87,.45));
    transition: filter .9s cubic-bezier(.2,.7,.25,1);
  }
  #kkfk-intro.kilit .arma img {
    filter: drop-shadow(0 0 50px rgba(47,167,87,.8)) brightness(1.05);
  }

  /* ---------- GEÇ ---------- */
  .gec {
    position: absolute; z-index: 3;
    right: clamp(16px, 4vw, 38px); bottom: clamp(16px, 4vh, 34px);
    background: none; border: 0; cursor: pointer; color: rgba(255,255,255,.42);
    font: inherit; font-size: 11px; letter-spacing: .22em; text-transform: uppercase;
    padding: 10px 4px; opacity: 0; animation: kkfk-fadeIn .5s 1s forwards; transition: color .25s;
  }
  .gec:hover, .gec:focus-visible { color: var(--kkfk-cim-parlak); }
  @keyframes kkfk-fadeIn { to { opacity: 1; } }

  /* Reduced-motion'da zaten pre-paint script atlıyor; yine de güvence */
  @media (prefers-reduced-motion: reduce) { #kkfk-intro { display: none !important; } }
</style>

<script is:inline>
  // Main: overlay DOM hazır. Atlanıyorsa kaldır; değilse oynat → kapat.
  (function () {
    var perde = document.getElementById('kkfk-intro');
    if (!perde) return;

    if (document.documentElement.classList.contains('kkfk-skip')) {
      if (perde.parentNode) perde.parentNode.removeChild(perde);
      return;
    }

    var video = perde.querySelector('.plate');
    var logo  = perde.querySelector('.arma img');
    var gec   = perde.querySelector('.gec');
    var KILIT = 2400;   // ms — armanın parladığı an
    var ACILIS = 3100;  // ms — perdenin kalkması
    var zam = [], bitti = false;

    // Varlıklar yalnızca oynatılacaksa yüklenir
    if (logo) logo.src = '/intro/arma.webp';

    // Video HAZIR OLANA KADAR oynatılmaz. Yoksa yükleme sürerken video
    // görünmez hâlde ilerliyor ve yıldızların aktığı ilk ~1.2 sn kaçıyor;
    // perde açıldığında geriye sadece sönen parıltı kalıyor.
    // Hazır olunca: oynatma + görünürlük + kapanış sayacı hep birlikte
    // başlar, böylece akış her zaman baştan izlenir ve takılma olmaz.
    var basladi = false;
    function oynat() {
      try {
        var p = video.play();
        if (p && p.catch) p.catch(function () {});
      } catch (e) {}
    }
    function sahneyiBaslat() {
      if (basladi || bitti) return;
      basladi = true;
      perde.classList.add('plate-hazir');

      // OYNATMA İLK BOYAMAYA KADAR ERTELENİR. Aksi hâlde video, sayfa
      // hâlâ yükleniyorken (ayrıştırma sırasında) oynamaya başlıyor;
      // ana iş parçacığı meşgulken hiçbir kare ekrana basılamıyor ama
      // medya saati gerçek zamanda akmaya devam ediyor. Yavaş makinede
      // tarayıcı ilk kareyi basabildiğinde yıldız akışı (0.1-1.2 sn)
      // çoktan bitmiş oluyor; geriye yalnızca sönmüş parıltı kalıyor.
      // İç içe iki rAF, tarayıcı gerçekten boyayabilene kadar bekler.
      var raf = window.requestAnimationFrame || function (f) { return setTimeout(f, 16); };
      raf(function () {
        raf(function () {
          if (bitti) return;
          if (video) {
            oynat();
            // play() sessizce reddedilirse (otomatik oynatma engeli, iOS
            // düşük güç modu) video 0. karede donar; o kare neredeyse
            // siyah olduğu için hiçbir şey görünmez. Birkaç kez deneriz.
            var deneme = 0;
            var nabiz = setInterval(function () {
              if (bitti || ++deneme > 6 || (!video.paused && video.currentTime > 0)) {
                clearInterval(nabiz);
                return;
              }
              oynat();
            }, 250);

            // Oynatma gerçekten engellendiyse (Opera'nın veri tasarrufu /
            // otomatik oynatma kısıtı gibi) video 0. karede kalır ve o
            // kare neredeyse siyah olduğu için ekranda hiçbir şey
            // görünmez. Bu durumda yıldızların yoğun olduğu ana bir kez
            // atlayıp duruk da olsa akışı gösteriyoruz.
            zam.push(setTimeout(function () {
              if (bitti) return;
              if (video.paused || video.currentTime < 0.05) {
                try { video.currentTime = 0.8; } catch (e) {}
              }
            }, 700));
          }
          // Kapanış sayacı da buradan başlar: perde, videonun görünür
          // olduğu andan itibaren ölçülen süre kadar açık kalsın.
          zam.push(setTimeout(function () { perde.classList.add('kilit'); }, KILIT));
          zam.push(setTimeout(bitir, ACILIS));
        });
      });
    }

    if (video) {
      video.muted = true;
      // Kapak karesi: yıldızların en yoğun anından alınmış duruk görüntü.
      // Opera gibi oynatmayı kısıtlayan tarayıcılarda video hiç
      // başlamazsa ekran boş kalmasın, yıldızlar yine görünsün.
      video.poster = '/intro/plate-poster.jpg';
      // Motorlar farklı olaylarla hazır oluyor; hangisi önce gelirse.
      video.addEventListener('canplay', sahneyiBaslat);
      video.addEventListener('loadeddata', sahneyiBaslat);
      video.addEventListener('playing', sahneyiBaslat);
      video.addEventListener('error', function () {
        // Video ARTIK GİZLENMİYOR: hata durumunda tarayıcı kapak
        // karesini gösterir, yani yıldızlar duruk da olsa görünür.
        // Ayrıca mix-blend-mode: screen sayesinde siyah bir kutu zaten
        // arkadaki yeşil ışığı örtmüyor; gizlemenin faydası yoktu,
        // aksine ekranı boşaltıyordu.
        sahneyiBaslat();
      });
      video.src = '/intro/kkfk-plate.mp4';
    }
    // Ağ yavaşsa ya da olay hiç gelmezse sahne yine de başlasın
    zam.push(setTimeout(sahneyiBaslat, 1500));
    // Mutlak güvence: hiçbir koşulda perde asılı kalmasın
    zam.push(setTimeout(bitir, 6500));

    function bitir() {
      if (bitti) return;
      bitti = true;
      zam.forEach(clearTimeout); zam = [];
      perde.classList.add('bitti');
      document.documentElement.classList.remove('kkfk-playing');
      setTimeout(function () {
        perde.classList.add('kapali');
        if (video) { try { video.pause(); } catch (e) {} }
        if (perde.parentNode) perde.parentNode.removeChild(perde);
      }, 900);
    }

    gec.addEventListener('click', bitir);
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') bitir(); });
  })();
</script>
