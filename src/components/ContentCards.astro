---
/**
 * Ana sayfadaki haber kartları. Sorgu index.astro'da (tek sorgu); buraya
 * en yeni haberden SONRAKİ üç kayıt prop olarak gelir. Sabit 3 slot ve
 * yer tutucu yedek yok: veri yoksa bölüm hiç basılmaz.
 */
import { type NewsItem } from '../lib/supabase';
import { img, imgSet } from '../lib/img';
import { newsPath, formatDate, isoDate } from '../lib/news';

interface Props {
  items: NewsItem[];
}
const { items } = Astro.props;
---

{items.length > 0 && (
  <section class="band content-cards" aria-label="Haberler">
    <div class="band-inner">
      <h2>Haberler</h2>

      <div class="cards-grid">
        {items.map(n => (
          <a href={newsPath(n)} class="card">
            {n.image_url
              ? (
                <span class="card-media">
                  <img
                    src={img(n.image_url, 400)}
                    srcset={imgSet(n.image_url, [400, 800])}
                    sizes="(max-width: 767px) 100vw, (max-width: 1119px) 50vw, 33vw"
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                </span>
              )
              : <span class="card-media foto-yok"></span>
            }
            <h3 class="card-title">{n.title}</h3>
            <span class="card-meta">
              {formatDate(n.published_at) && (
                <time datetime={isoDate(n.published_at)}>{formatDate(n.published_at)}</time>
              )}
            </span>
          </a>
        ))}
      </div>

      <!-- Üçüncül bağlantı: keşif, vurgu rengi yok -->
      <a href="/haberler" class="link-tertiary">Tüm haberler →</a>
    </div>
  </section>
)}

<style>
  .content-cards {
    background: var(--black);
    border-top: 1px solid var(--border);
  }

  /* Izgara formülü (§2.3): 3'ten az öğede kartlar sola yığılır */
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(min(280px, 100%), 1fr));
    gap: var(--sp-3);
  }
  @media (max-width: 1119px) { .cards-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 767px)  { .cards-grid { grid-template-columns: 1fr; } }

  .link-tertiary {
    display: inline-block;
    font-size: var(--fs-sm);
    color: var(--text-muted);
    text-decoration: none;
    transition: color .2s;
  }
  .link-tertiary:hover { color: var(--text); }
  .link-tertiary:focus-visible { outline: 2px solid var(--green-bright); outline-offset: 3px; }
</style>
